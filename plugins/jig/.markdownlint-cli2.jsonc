{
  // jig's markdown, linted under the root config plus the exemptions below. Same
  // ratchet philosophy as ../../.markdownlint-cli2.jsonc — block new violations of
  // every still-enabled rule — but jig's prompt files need three rules off, and two
  // of them are correctness, not style:
  //
  //   MD038 — jig documents whitespace-significant tokens inside code spans. The
  //     `PLAN.md` heading suffixes ` [PASS]` / ` [REPLAN]` / ` [ESCALATE]` carry a
  //     leading space that is part of `scripts/status-flip`'s own `SUFFIX_RE`
  //     grammar, and `### ` describes an ATX prefix including its space. Running
  //     markdownlint --fix against this rule silently rewrites the grammar.
  //   MD025 — prose wraps land issue references like `#13` at the start of a line,
  //     which the parser reads as an H1. Rewrapping to dodge the parser would make
  //     the source worse, not better.
  //   MD024 — CHANGELOG.md repeats "Features" / "Bug Fixes" per release by design;
  //     the skills repeat structural section names across steps for the same reason.
  "config": {
    "extends": "../../.markdownlint-cli2.jsonc",
    "MD024": false,
    "MD025": false,
    "MD038": false
  }
}
