#!/usr/bin/env python3
"""studious — the one entrypoint for the plugin's executables (#346).

    studious <verb> [args …]

A verb that names a `scripts/` executable execs it; every other verb execs
`bin/gate-ledger`, which owns the ledger vocabulary and refuses what it does
not know. No argument changes shape here: this file dispatches, it never
interprets. Rules the doors used to carry in prose land as new verbs of this
entrypoint; the prose then names `studious <verb>` and nothing else.

Exit codes are the target's own. `studious` alone, `-h`, `--help`, or `help`
prints the verb table and exits 2, the usage code every sibling shares.
`--version` prints the plugin manifest's version.
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SCRIPTS_DIR = ROOT / "scripts"
LEDGER = ROOT / "bin" / "gate-ledger"
MANIFEST = ROOT / ".claude-plugin" / "plugin.json"

# Ledger verbs, mirrored from bin/gate-ledger's dispatch; tests/jig/test_studious_cli.py
# fails if the two drift.
LEDGER_VERBS = (
    "record", "status", "gate-get",
    "episode-open", "episode-round", "episode-verdict", "episode-finding", "episode-get",
    "work-set", "work-log", "work-get", "work-list",
    "evidence-append", "evidence-list",
    "gc",
)


def script_verbs() -> list:
    """Every executable in scripts/ without a suffix — the door-run CLIs, never
    the CI helpers (`*.py`) or the dev installer (`*.sh`)."""
    return sorted(
        p.name for p in SCRIPTS_DIR.iterdir()
        if p.is_file() and not p.suffix and os.access(p, os.X_OK)
    )


def usage() -> str:
    return (
        "usage: studious <verb> [args …]\n"
        "  build scripts:  " + " ".join(script_verbs()) + "\n"
        "  ledger verbs:   " + " ".join(LEDGER_VERBS) + "\n"
        "`studious <verb> --help` for a script's own usage; ledger verbs print gate-ledger's."
    )


def version() -> str:
    try:
        return json.loads(MANIFEST.read_text(encoding="utf-8"))["version"]
    except (OSError, ValueError, KeyError):
        return "unknown"


def main(argv: list) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(usage(), file=sys.stderr)
        return 2
    if argv[0] == "--version":
        print(version())
        return 0
    verb = argv[0]
    if verb in script_verbs():
        target = SCRIPTS_DIR / verb
        os.execv(str(target), [str(target), *argv[1:]])
    os.execv(str(LEDGER), [str(LEDGER), *argv])
    return 0  # unreachable: execv replaces the process


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
