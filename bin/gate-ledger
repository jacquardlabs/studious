#!/usr/bin/env bash
# gate-ledger — read/write Studious's local, gitignored .studious/ state.
#
# Stores in the consuming project:
#   .studious/gates/<branch-slug>.json  — per-branch gate verdicts. Written via
#     `record`; read via `status` (on demand) and `gate-get` (/next's evidence
#     check), never as a raw file. Also carries `episodes` (#289): one bounded
#     gate episode per gate, written via `episode-open`/`-round`/`-verdict` (schema
#     at those verbs); legacy readers branch only on `.branch`/`.gates`, so it
#     rides along inertly. A gate's entry optionally carries `blockingLanes`
#     (delta-scoped re-audit, #130), set via `record --blocking-lanes` or
#     `episode-verdict`'s passthrough, when the verdict is the retry token —
#     read by commands/review.md to narrow the next round's dispatch. Absent on
#     every other verdict and on pre-#130 records — indistinguishable from
#     malformed, which the reader fails closed on (full audit).
#   .studious/work/<feature-slug>.json  — per-feature flow position for /next
#     (`work-set`/`work-log` write, `work-get`/`work-list` read). Scope-delta
#     fields (#244): `declaredFiles` — the forecast of exact files the story
#     touches (`work-set --declared-files`); absent means never declared
#     (measured as `unmeasured`, never zero). `scopeDelta` — append-only, one
#     entry per measured moment (`{phase, unmeasured, outsideFiles, sha, at}`,
#     plus `reason` on an unmeasured entry only), written via `work-log
#     --scope-delta-phase P (--scope-delta-files F1,F2 | --scope-delta-unmeasured
#     [--scope-delta-reason R])`. `amendments` — separate append-only array
#     (`{file, phase, reason, at}`) justifying a file some `scopeDelta` entry
#     already counted outside the declaration; never edits that entry or its
#     count.
#   .studious/evidence/<branch-slug>.jsonl — append-only, harness-captured
#     verification commands run while a story is armed (`evidence-append` by
#     hooks/evidence-capture.sh writes; `evidence-list` reads —
#     reference/evidence-format.md).
# All stores are anchored to the MAIN working tree (see repo_root), so agents in
# linked worktrees share one .studious/ store.
# Degrades silently when git or jq is unavailable.
set -uo pipefail

branch_name() { git rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD; }
branch_slug() { local b; b="${1:-$(branch_name)}"; printf '%s' "${b//\//-}"; } # optional arg: slug for a given branch instead of the current one
head_sha()    { git rev-parse --short HEAD 2>/dev/null || echo ""; }
now_iso()     { date -u +%Y-%m-%dT%H:%M:%SZ; }

have() { command -v "$1" >/dev/null 2>&1; }

repo_root() {
  # Anchor state to the MAIN working tree so agents running in linked
  # worktrees (e.g. /next story worktrees) share one .studious/ store.
  local common
  common=$(git rev-parse --git-common-dir 2>/dev/null) || return 1
  common=$(cd "$common" 2>/dev/null && pwd) || return 1  # may be relative ".git"
  case "$common" in
    */.git) printf '%s' "${common%/.git}" ;;
    *) git rev-parse --show-toplevel 2>/dev/null ;;  # bare/odd layouts: old behavior
  esac
}

ledger_dir() {
  # Anchor to the main working tree so the ledger location doesn't depend on
  # the caller's CWD or worktree; degrade to CWD-relative outside a git repo.
  local root
  if root=$(repo_root); then
    printf '%s/.studious/gates' "$root"
  else
    printf '.studious/gates'
  fi
}

store_dir() { # name -> .studious/<name>, root-anchored like ledger_dir
  # Same root-anchoring as ledger_dir, one function for every store instead of
  # a copy per name. A worker in a linked worktree still lands records in the
  # MAIN tree's .studious/<name>/ — e.g. evidence shares a file
  # joinable without a cross-worktree read.
  local name="$1"
  local root
  if root=$(repo_root); then
    printf '%s/.studious/%s' "$root" "$name"
  else
    printf '.studious/%s' "$name"
  fi
}

slugify() {
  # Feature title/slug → filesystem- and JSON-safe key: lowercase, runs of
  # anything outside [a-z0-9] collapse to '-', edges trimmed.
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//; s/-*$//'
}

ensure_gitignore() {
  # Self-heal: keep .studious/ out of git status even for projects initialized
  # before the ledger existed. Anchored to the main tree so a linked worktree
  # heals the main .gitignore, not its own.
  local root gi
  root=$(repo_root) || return 0
  gi="$root/.gitignore"
  if [ ! -f "$gi" ] || ! grep -qxF '.studious/' "$gi" 2>/dev/null; then
    printf '\n# Studious local gate ledger (do not commit)\n.studious/\n' >> "$gi"
  fi
}

json_update() { # file, jq filter, then any --arg name value ... pairs for jq
  # Shared writer for every mutating verb: jq into a same-directory temp file,
  # then rename over $file — all-or-nothing, same as a hand-written block.
  #
  # Deliberately no RETURN trap: a trap armed here doesn't stay scoped to this
  # function — bash re-fires it when the *calling* verb returns, by which point
  # this function's own $tmp is out of scope, and under `set -u` that's an
  # unbound-variable abort that clobbers the verb's real exit status. Cleanup
  # below is an explicit branch instead.
  local file="$1" filter="$2"
  shift 2
  local dir tmp rc
  dir=$(dirname -- "$file")
  tmp=$(mktemp "$dir/.tmp.XXXXXX")
  # Capture $? as its own statement, not an `if` condition: POSIX defines a
  # no-branch-taken `if` as exit 0, which would silently swallow a jq/mv failure.
  jq "$@" "$filter" "$file" > "$tmp" && mv "$tmp" "$file"
  rc=$?
  if [ "$rc" -eq 0 ]; then
    return 0
  fi
  rm -f "$tmp"
  return "$rc"
}

gates_file_init() { # ensures the current branch's gates file exists, echoes its path
  local dir; dir=$(ledger_dir)
  mkdir -p "$dir"
  local file; file="$dir/$(branch_slug).json"
  [ -f "$file" ] || printf '{"schemaVersion":1,"branch":"","gates":{}}' > "$file"
  printf '%s' "$file"
}

cmd_record() {
  local gate="" verdict="" blocking_lanes=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --gate)            gate="$2"; shift 2 ;;
      --verdict)         verdict="$2"; shift 2 ;;
      --blocking-lanes)  blocking_lanes="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$gate" ] || [ -z "$verdict" ]; then
    echo "gate-ledger: --gate and --verdict required" >&2
    return 2
  fi
  if ! have jq || ! have git; then
    echo "gate-ledger: record skipped (jq and git required)" >&2
    return 0
  fi

  ensure_gitignore
  local file; file=$(gates_file_init)

  local branch sha rc
  branch="$(branch_name)"
  sha="$(head_sha)"
  # blockingLanes (delta-scoped re-audit, #130): --blocking-lanes is
  # trimmed/deduped into a JSON array, added only when non-empty. Every
  # `record` call fully replaces the gate's entry, so a verdict recorded
  # without the flag correctly leaves the field absent rather than carrying a
  # stale list forward — absence is the malformed/unavailable signal
  # review.md's re-audit-scope reader fails closed on.
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  json_update "$file" \
    'def csv_trim: split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""));
     .schemaVersion = (.schemaVersion // 1)
     | .branch = $b
     | .gates[$g] = ({verdict: $v, sha: $s, ranAt: $t}
         + (if $bl != "" then {blockingLanes: ($bl | csv_trim)} else {} end))' \
    --arg b "$branch" --arg g "$gate" --arg v "$verdict" \
    --arg s "$sha" --arg t "$(now_iso)" --arg bl "$blocking_lanes"
  rc=$?

  return "$rc"
}

cmd_status() {
  if ! have jq || ! have git; then return 0; fi
  local dir; dir=$(ledger_dir)
  local file; file="$dir/$(branch_slug).json"
  [ -f "$file" ] || return 0

  local head cur_branch stored_branch branch_mismatch
  head=$(head_sha)
  cur_branch=$(branch_name)
  stored_branch=$(jq -r '.branch // empty' "$file")
  branch_mismatch=0
  # branch_slug() collapses '/' to '-', so e.g. feat/foo and feat-foo share a
  # ledger file. If the branch recorded in the file isn't the branch we're
  # actually on, the file was written by the other branch — don't trust its
  # verdicts, report as if nothing was ever recorded for this branch.
  [ "$stored_branch" = "$cur_branch" ] || branch_mismatch=1

  # Gate→pass-token→mode table: "gate:PASS_TOKEN:MODE". The one gate is
  # required: absence flags ("never ran"), a clean verdict at HEAD joins the
  # "proceed" summary.
  local gates=("audit:PASS:required")
  local msgs=()
  local pass_parts=()
  local gate pass mode v s entry rest
  for entry in "${gates[@]}"; do
    gate="${entry%%:*}"
    rest="${entry#*:}"
    pass="${rest%%:*}"
    mode="${rest##*:}"
    if [ "$branch_mismatch" -eq 1 ]; then
      v=""
      s=""
    else
      # Bracket index, not dot-syntax: .gates.$gate parses '-' as subtraction
      # and compile-errors on hyphenated gate names (e.g. should-we-build).
      v=$(jq -r --arg g "$gate" '.gates[$g].verdict // empty' "$file")
      s=$(jq -r --arg g "$gate" '.gates[$g].sha // empty' "$file")
    fi
    if [ -z "$v" ]; then
      [ "$mode" = "required" ] && msgs+=("$gate never ran on this branch")
      continue
    fi
    if [ "$s" != "$head" ]; then
      n=$(git rev-list --count "$s..$head" 2>/dev/null || git rev-list --count "$s..HEAD" 2>/dev/null)
      if [ -n "$n" ] && [ "$n" -gt 0 ] 2>/dev/null; then
        if [ "$n" -eq 1 ]; then unit=commit; else unit=commits; fi
        msgs+=("$gate ran $n $unit ago — re-run before merging")
      else
        msgs+=("$gate ran at $s but HEAD is $head — re-run before merging")
      fi
      continue
    fi
    if [ "$v" != "$pass" ]; then
      msgs+=("$gate returned $v")
      continue
    fi
    # Clean at HEAD: required gates join the proceed summary; an advisory
    # gate's clean state (CLEAR) is silent, same as its absence.
    [ "$mode" = "required" ] && pass_parts+=("$gate ($pass)")
  done

  if [ "${#msgs[@]}" -eq 0 ]; then
    local pass_str=""
    if [ "${#pass_parts[@]}" -gt 0 ]; then
      pass_str="${pass_parts[0]}"
      local i
      for (( i=1; i<${#pass_parts[@]}; i++ )); do
        pass_str="$pass_str and ${pass_parts[$i]}"
      done
    fi
    printf '%s ran on this branch at HEAD — proceed.' "$pass_str"
  else
    local joined; joined=$(printf '%s; ' "${msgs[@]}"); joined=${joined%; }
    printf 'Studious gate check — %s. Proceed anyway?' "$joined"
  fi
}

cmd_gate_get() {
  local branch=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --branch) branch="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  local slug; slug=$(branch_slug "$branch")
  local file; file="$(ledger_dir)/$slug.json"
  [ -f "$file" ] || return 0
  cat "$file"
}

# Gate episodes (#289): one bounded run of a gate on a branch — opened at a sha,
# advanced by at most one fix round, closed by a verdict. Lives in the same
# per-branch gates file as `.gates`, under `.episodes[<gate>]`:
#
#   {sha, round, openedAt}              after episode-open (round is always 1)
#   {sha, round, openedAt, verdict, verdictAt}  after episode-verdict
#   + findings: {<fingerprint>: {lane, severity, round, status, ...}} once
#     episode-finding records (full shape at cmd_episode_finding below)
#   + blockingByRound: {"<round>": <count>} — blocking-finding count each round
#     left behind, snapshotted by episode-round (#291)
#   + escalated: {round, blocking, priorBlocking, at} — set when episode-round
#     refuses a non-converging round (#291); the human decides from there
#
# `sha` is the code state the episode's latest judgment saw: HEAD at open,
# refreshed by episode-verdict so the episode record and the dual-written
# legacy `.gates` entry always agree. The round cap bounds ONE episode, never
# the branch — a fresh `episode-open` replaces it at round 1, making the cap a
# stop-and-rethink point, not a lockout. "Closed by exactly one verdict" means
# one TERMINAL verdict: the shared retry token (reference/gate-vocabulary.md)
# is a round OUTCOME, so episode-round re-enters it (clears the outcome, keeps
# findings) while every other verdict refuses episode-round/-finding, and
# episode-verdict refuses to overwrite. Two doors stay open while the retry
# outcome rides, so neither refusal's prescribed fix is itself refused:
# episode-finding accepts a set-aside disposition of an already-recorded
# finding, and — at the round cap only — episode-verdict accepts a TERMINAL
# verdict over the riding outcome. Reopening past a terminal verdict is always
# the explicit episode-open act, which archives the prior episode under
# `.episodeHistory[<gate>]`, readable via `episode-get --history` (#300).
EPISODE_ROUND_CAP=2
# The one fix-and-retry spelling every episode gate shares — canonical source
# reference/gate-vocabulary.md; tests/python/test_episode_contract.py pins the
# two against each other.
EPISODE_RETRY_VERDICT="FIX AND RE-REVIEW"

episode_round_get() { # gate → prints the current branch's recorded round for that gate's episode, nothing if no episode is open
  local file; file="$(ledger_dir)/$(branch_slug).json"
  [ -f "$file" ] || return 0
  jq -r --arg g "$1" '.episodes[$g].round // empty' "$file" 2>/dev/null
}

episode_verdict_get() { # gate → prints the episode's verdict if closed, nothing if open or absent
  local file; file="$(ledger_dir)/$(branch_slug).json"
  [ -f "$file" ] || return 0
  jq -r --arg g "$1" '.episodes[$g].verdict // empty' "$file" 2>/dev/null
}

episode_blocking_count() { # gate → how many findings the episode currently carries in a
  # merge-blocking state: status `open` at Critical or Important (Track never
  # blocks, reference/severity-rubric.md; carried/waived/rejected-as-noise are
  # set aside). Always prints a number, 0 if there's no episode/findings/file.
  local file count; file="$(ledger_dir)/$(branch_slug).json"
  count=""
  if [ -f "$file" ]; then
    # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
    count=$(jq -r --arg g "$1" \
      '[(.episodes[$g].findings // {})[]
        | select(.status == "open" and (.severity == "Critical" or .severity == "Important"))]
       | length' "$file" 2>/dev/null)
  fi
  case "$count" in
    ''|*[!0-9]*) count=0 ;;
  esac
  printf '%s' "$count"
}

episode_open_critical_count() { # gate → how many Criticals the episode still carries `open`
  # Deliberately not episode_blocking_count with a filter bolted on: that is the
  # convergence metric (Critical + Important), this is the verdict guard's —
  # only a Critical blocks a verdict, an Important may ride out a terminal PASS
  # still `open` (reference/gate-vocabulary.md). Always prints a number.
  local file count; file="$(ledger_dir)/$(branch_slug).json"
  count=""
  if [ -f "$file" ]; then
    # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
    count=$(jq -r --arg g "$1" \
      '[(.episodes[$g].findings // {})[]
        | select(.status == "open" and .severity == "Critical")]
       | length' "$file" 2>/dev/null)
  fi
  case "$count" in
    ''|*[!0-9]*) count=0 ;;
  esac
  printf '%s' "$count"
}

cmd_episode_open() {
  local gate=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --gate) gate="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$gate" ]; then
    echo "gate-ledger: --gate required" >&2
    return 2
  fi
  if ! have jq || ! have git; then
    echo "gate-ledger: episode-open skipped (jq and git required)" >&2
    return 0
  fi

  ensure_gitignore
  local file; file=$(gates_file_init)
  # Fail named HERE on an unparseable gates file, rather than reaching the jq
  # below and surfacing a bare `jq: parse error` under an undocumented exit
  # code: `episode-round`/`-verdict`/`-finding` all read the round through
  # `episode_round_get`, whose `2>/dev/null` turns a parse failure into "no
  # open episode" (exit 2), which commands/review.md routes straight to
  # episode-open as if the ledger predated episodes. Exit 1 is the same
  # state-refusal code for a corrupted file; nothing is
  # repaired here since only a human can say what the file should hold.
  if [ -f "$file" ] && ! jq empty "$file" 2>/dev/null; then
    echo "gate-ledger: episode-open: the gates file at $file is not valid JSON —" \
         "repair or remove it before continuing" >&2
    return 1
  fi
  # Reopening starts fresh at round 1 without discarding the prior episode: it
  # is archived under `.episodeHistory[<gate>]` first (findings, waivers,
  # verdict), so a carried Critical's waiver reason survives. The prior
  # episode's dual-written `.gates` entry survives too.
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  json_update "$file" \
    '.schemaVersion = (.schemaVersion // 1)
     | .branch = $b
     | (if .episodes[$g] then .episodeHistory[$g] = ((.episodeHistory[$g] // []) + [.episodes[$g]]) else . end)
     | .episodes[$g] = {sha: $s, round: 1, openedAt: $t}' \
    --arg b "$(branch_name)" --arg g "$gate" --arg s "$(head_sha)" --arg t "$(now_iso)"
}

cmd_episode_round() {
  local gate=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --gate) gate="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$gate" ]; then
    echo "gate-ledger: --gate required" >&2
    return 2
  fi
  if ! have jq || ! have git; then
    echo "gate-ledger: episode-round skipped (jq and git required)" >&2
    return 0
  fi

  local round; round=$(episode_round_get "$gate")
  if [ -z "$round" ]; then
    echo "gate-ledger: no open episode for gate '$gate' on this branch (run episode-open first)" >&2
    return 2
  fi
  local closed; closed=$(episode_verdict_get "$gate")
  if [ -n "$closed" ] && [ "$closed" != "$EPISODE_RETRY_VERDICT" ]; then
    echo "gate-ledger: episode for gate '$gate' is closed (verdict '$closed' recorded) —" \
         "run episode-open to start a fresh one" >&2
    return 2
  fi
  case "$round" in
    *[!0-9]*) echo "gate-ledger: episode-round: corrupted round '$round' for gate '$gate'" >&2; return 1 ;;
  esac
  local file; file="$(ledger_dir)/$(branch_slug).json"
  local blocking prior rc
  blocking=$(episode_blocking_count "$gate")
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  prior=$(jq -r --arg g "$gate" --arg r "$((round - 1))" \
    '.episodes[$g].blockingByRound[$r] // empty' "$file" 2>/dev/null)
  case "$prior" in
    ''|*[!0-9]*) prior="" ;;
  esac
  # Convergence, checked BEFORE the cap (#291): the cap bounds the loop but
  # can't tell "converged" from "gave up" — both exit the same way. A round
  # that failed to strictly reduce the blocking set is refused here and the
  # episode marked escalated, so a human decides rather than the loop spending
  # its last round. Exit 3 keeps this distinct from the cap's exit 1.
  #
  # A prior count of 0 is not a convergence signal, so the comparison runs only
  # against a non-zero predecessor.
  #
  # This fires on the natural round-2 boundary, not latent under the current
  # cap: the first `episode-round` call banks `blockingByRound["1"]`, so the
  # second reads a real predecessor and refuses at exit 3 whenever the
  # blocking set failed to shrink. Only a converging round (or a zero
  # predecessor) reaches the cap's exit 1. Do not delete this as dead code.
  if [ -n "$prior" ] && [ "$prior" -gt 0 ] && [ "$blocking" -ge "$prior" ]; then
    # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
    json_update "$file" \
      '.episodes[$g].escalated = {round: ($r | tonumber), blocking: ($b | tonumber),
                                  priorBlocking: ($p | tonumber), at: $t}' \
      --arg g "$gate" --arg r "$round" --arg b "$blocking" --arg p "$prior" --arg t "$(now_iso)"
    rc=$?
    # The escalation record IS this branch's durable product. If the write
    # failed, say so instead of announcing a record that doesn't exist:
    # returning 3 would claim "marked escalated" over an untouched file. Exit 1
    # instead — both doors read 1 as "stop, put the choice to the user" either
    # way; the round is still refused, only the bookkeeping is missing.
    if [ "$rc" -ne 0 ]; then
      echo "gate-ledger: episode-round: the escalation record for gate '$gate' could NOT be written" \
           "to $file (write failed, exit $rc) — round $round carries $blocking blocking finding(s)" \
           "against the prior round's $prior, so this round is still refused, but nothing was" \
           "recorded and no episode is marked escalated. Fix the write (permissions, disk space)" \
           "and re-run, or take the non-convergence to a human directly" >&2
      return 1
    fi
    echo "gate-ledger: episode-round refused for gate '$gate' — round $round carries $blocking blocking" \
         "finding(s) against the prior round's $prior: the episode is not converging, and it is now marked" \
         "escalated. Put the choice to a human — waive what will not be fixed, or episode-open a fresh" \
         "episode — before spending another round" >&2
    return 3
  fi
  # Enforced HERE, in code, never left to a prompt's own counting ("code owns
  # bookkeeping"): round 1 is the first run, round 2 the one fix-and-re-check,
  # a third round is refused — exit 1, distinct from the arg-validation 2s above.
  if [ "$round" -ge "$EPISODE_ROUND_CAP" ]; then
    echo "gate-ledger: episode-round refused for gate '$gate' — round $round is already recorded and" \
         "the ${EPISODE_ROUND_CAP}-round cap allows no third round; record a verdict, or episode-open a fresh episode" >&2
    return 1
  fi
  # Re-entering clears the round outcome (retry token), never the findings; the
  # dual-written legacy `.gates` entry keeps the retry token untouched, which
  # is what the door's re-entry condition reads. The round left behind banks
  # its blocking count first, for the next round's convergence check.
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  json_update "$file" \
    '.episodes[$g].round = (.episodes[$g].round + 1)
     | .episodes[$g].blockingByRound = ((.episodes[$g].blockingByRound // {}) + {($r): ($b | tonumber)})
     | .episodes[$g] |= del(.verdict, .verdictAt)' \
    --arg g "$gate" --arg r "$round" --arg b "$blocking"
}

cmd_episode_verdict() {
  local gate="" verdict="" blocking_lanes=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --gate)           gate="$2"; shift 2 ;;
      --verdict)        verdict="$2"; shift 2 ;;
      --blocking-lanes) blocking_lanes="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$gate" ] || [ -z "$verdict" ]; then
    echo "gate-ledger: --gate and --verdict required" >&2
    return 2
  fi
  if ! have jq || ! have git; then
    echo "gate-ledger: episode-verdict skipped (jq and git required)" >&2
    return 0
  fi

  local round; round=$(episode_round_get "$gate")
  if [ -z "$round" ]; then
    echo "gate-ledger: no open episode for gate '$gate' on this branch (run episode-open first)" >&2
    return 2
  fi
  local prior; prior=$(episode_verdict_get "$gate")
  if [ -n "$prior" ]; then
    if [ "$prior" = "$EPISODE_RETRY_VERDICT" ]; then
      # Normally the next verdict arrives through episode-round's re-entry. At
      # the round cap that re-entry is refused in code, and pointing there
      # anyway wedged the operator between two refusals (cap says "record a
      # verdict", this one said "run episode-round"). So the cap is exactly
      # where a TERMINAL verdict may land over the riding outcome — the retry
      # token is a round outcome, not a closing verdict, so "closed by exactly
      # one verdict" still holds, and rule 2 below still refuses to close over
      # an open Critical (waive it first via episode-finding). Below the cap
      # the re-entry stays the only path; a corrupt round fails closed.
      local at_cap=0
      case "$round" in
        *[!0-9]*) ;;
        *) if [ "$round" -ge "$EPISODE_ROUND_CAP" ]; then at_cap=1; fi ;;
      esac
      if [ "$at_cap" -eq 1 ] && [ "$verdict" != "$EPISODE_RETRY_VERDICT" ]; then
        : # fall through: the terminal verdict closes the episode over its spent retry outcome
      elif [ "$at_cap" -eq 1 ]; then
        echo "gate-ledger: episode for gate '$gate' already carries round outcome '$prior' and the" \
             "${EPISODE_ROUND_CAP}-round cap allows no further re-entry — re-recording the retry" \
             "outcome moves nothing; record a terminal verdict to close the episode, or episode-open" \
             "a fresh one" >&2
        return 1
      else
        echo "gate-ledger: episode for gate '$gate' carries round outcome '$prior' —" \
             "run episode-round to re-enter its re-review before recording the next verdict" >&2
        return 1
      fi
    else
      echo "gate-ledger: episode for gate '$gate' is already closed by verdict '$prior' —" \
           "an episode is closed by exactly one verdict; run episode-open to re-judge in a fresh one" >&2
      return 1
    fi
  fi
  # Rule 2, at the verdict: an unfixed Critical needs the operator's explicit
  # word before an episode closes on it. `episode-finding` already refuses to
  # set a Critical aside without --waiver, but nothing stopped a caller
  # leaving it `open` and recording the verdict over the top — same outcome,
  # none of the accountability — so the findings ledger is consulted here too.
  #
  # The retry verdict is exempt by construction: `FIX AND RE-REVIEW` IS "these
  # Criticals are open, go fix them" — refusing it would refuse the documented
  # main path. Every other token closes the episode, and a close needs the
  # word. Gate-agnostic rather than a per-gate proceed token, so it fails
  # closed for doors that adopt the episode verbs later.
  local open_criticals; open_criticals=$(episode_open_critical_count "$gate")
  if [ "$open_criticals" -gt 0 ] && [ "$verdict" != "$EPISODE_RETRY_VERDICT" ]; then
    echo "gate-ledger: episode-verdict refused for gate '$gate' — $open_criticals Critical" \
         "finding(s) are still 'open', and a verdict closing this episode cannot be recorded" \
         "over them. Resolve each one first (episode-finding --status closed), or set it aside" \
         "on the operator's own word (episode-finding --status carried --waiver <reason>)." \
         "'$EPISODE_RETRY_VERDICT' is recordable as-is — it is the round outcome that says" \
         "these are open" >&2
    return 1
  fi
  local file rc; file="$(ledger_dir)/$(branch_slug).json"
  # Merge, not replace: keeps round/openedAt, gains the verdict; `sha` is
  # refreshed to HEAD so it matches the sha the dual-write below stamps.
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  json_update "$file" \
    '.episodes[$g] = (.episodes[$g] + {verdict: $v, sha: $s, verdictAt: $t})' \
    --arg g "$gate" --arg v "$verdict" --arg s "$(head_sha)" --arg t "$(now_iso)"
  rc=$?
  [ "$rc" -eq 0 ] || return "$rc"
  # Dual-write the legacy per-gate record through cmd_record itself, not a
  # reimplementation of its jq, so `status`/`gate-get` see a record
  # indistinguishable from one a gate command wrote directly, events append
  # included. --blocking-lanes passes through untouched (#289): cmd_record
  # already owns that field.
  if [ -n "$blocking_lanes" ]; then
    cmd_record --gate "$gate" --verdict "$verdict" --blocking-lanes "$blocking_lanes"
  else
    cmd_record --gate "$gate" --verdict "$verdict"
  fi
  rc=$?
  # The episode write already landed, so a re-run of episode-verdict now
  # refuses this gate as closed — the only repair is cmd_record's own verb, so
  # the failure message names that exact command.
  if [ "$rc" -ne 0 ]; then
    # shellcheck disable=SC2016 # the quotes around $verdict are for the operator to copy-paste, not an expansion
    echo "gate-ledger: episode-verdict: the episode for gate '$gate' closed (verdict '$verdict'" \
         "recorded), but the legacy dual-write failed (exit $rc) — re-running episode-verdict" \
         "would refuse it as already closed; repair the legacy record directly:" \
         "gate-ledger record --gate $gate --verdict '$verdict'${blocking_lanes:+ --blocking-lanes '$blocking_lanes'}" >&2
  fi
  return "$rc"
}

# Findings ledger (episode convergence): a finding lives at
# .episodes[<gate>].findings[<fingerprint>] — the fingerprint IS the finding's
# identity across rounds, chosen by the caller and never normalized here:
#
#   {lane, severity, status, round, recordedAt, updatedAt}
#   + {regressionOf: <fp>}  when first recorded on round 2 as a regression of a
#                           round-1 finding
#   + {waiver: <reason>}    when carried under a waiver
#
# `severity` is the canonical three-tier ladder (reference/severity-rubric.md):
# Critical | Important | Track — callers map per-auditor labels into these
# before recording, as /review's orchestrator already does. A Critical must
# cite that rubric's objective anchor; one with no anchor is recorded
# Important instead, before the write, since severity is fixed at first record.
# `status` is open | closed | carried | waived | rejected-as-noise. The last is
# disposition memory (#292): a non-actionable ruling that's durable — later
# rounds read it via `episode-get --findings` and suppress similar findings
# (same lane, same fingerprint) instead of re-manufacturing them. `round` is
# stamped from the episode's current round at first record and never moves —
# it's what --regression-of validates against. `lane`/`severity` are fixed at
# first record: reclassifying a fingerprint is refused, so a Critical can
# never be laundered down to dodge the waiver rule below.
#
# Two convergence rules enforced HERE, in code (same posture as the round cap):
#
#   1. On round 2 a NEW blocking finding below Critical (`open`, Important —
#      Track never blocks) is refused unless --regression-of names a round-1
#      finding. Round 2 fixes round 1, it doesn't widen the blocking set; a
#      new Critical stays recordable as the stop signal.
#   2. A Critical reaches any set-aside status only with --waiver <reason>,
#      recorded on the finding. Setting it aside unfixed is accountable, never silent.
#
# Which agent judges whether something IS a regression stays in prose; this
# verb only refuses the write shapes those judgments must not produce.
finding_status_is_set_aside() { # status → true when it rides through the verdict unfixed
  case "$1" in
    carried|waived|rejected-as-noise) return 0 ;;
    *) return 1 ;;
  esac
}

# Both findings verbs render fields into line- and tab-structured reads
# (`episode-get --findings/--history`), which `/review`
# injects verbatim into the next round's lane dispatch prompts. A value
# carrying a newline or tab could forge an extra line, so identity fields are
# guarded at the boundary, same as `--fingerprint`.
finding_field_is_token() { # value → true when empty or a single whitespace-free token
  # For identity fields (`--lane`): `security-auditor`-shaped names, never
  # prose. Empty passes — callers that allow an omitted lane check for that themselves.
  case "$1" in
    *[[:space:][:cntrl:]]*) return 1 ;;
    *) return 0 ;;
  esac
}
finding_reason_is_single_line() { # value → true when empty or free of control characters
  # Deliberately WEAKER than the token guard above: a waiver is the operator's
  # own sentence (#300), so spaces must survive; `[[:cntrl:]]` covers the whole
  # attack surface (newline and tab). Do not unify with finding_field_is_token
  # — rejecting spaces would reduce every waiver reason to a single token.
  case "$1" in
    *[[:cntrl:]]*) return 1 ;;
    *) return 0 ;;
  esac
}

cmd_episode_finding() {
  local gate="" lane="" severity="" fingerprint="" status="" regression_of="" waiver=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --gate)          gate="$2"; shift 2 ;;
      --lane)          lane="$2"; shift 2 ;;
      --severity)      severity="$2"; shift 2 ;;
      --fingerprint)   fingerprint="$2"; shift 2 ;;
      --status)        status="$2"; shift 2 ;;
      --regression-of) regression_of="$2"; shift 2 ;;
      --waiver)        waiver="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$gate" ] || [ -z "$fingerprint" ] || [ -z "$status" ]; then
    echo "gate-ledger: --gate, --fingerprint, and --status required" >&2
    return 2
  fi
  case "$fingerprint" in
    *[[:space:][:cntrl:]]*)
      echo "gate-ledger: --fingerprint must be a single token with no whitespace or" \
           "control characters — it keys the findings map and one line of episode-get --findings" >&2
      return 2
      ;;
  esac
  if ! finding_field_is_token "$lane"; then
    echo "gate-ledger: --lane must be a single token with no whitespace or control" \
         "characters — it is a field of episode-get --findings' tab-separated detail line" >&2
    return 2
  fi
  if ! finding_reason_is_single_line "$waiver"; then
    echo "gate-ledger: --waiver must not contain control characters — it is the last field" \
         "of one episode-get --history line, and a newline or tab in it forges another" >&2
    return 2
  fi
  case "$status" in
    open|closed|carried|waived|rejected-as-noise) ;;
    *)
      echo "gate-ledger: --status '$status' is not a recognized finding status;" \
           "use open, closed, carried, waived, or rejected-as-noise" >&2
      return 2
      ;;
  esac
  if [ -n "$severity" ]; then
    case "$severity" in
      Critical|Important|Track) ;;
      *)
        echo "gate-ledger: --severity '$severity' is not a recognized tier;" \
             "use Critical, Important, or Track (reference/severity-rubric.md)" >&2
        return 2
        ;;
    esac
  fi
  if [ -n "$waiver" ] && ! finding_status_is_set_aside "$status"; then
    echo "gate-ledger: --waiver requires --status carried, waived, or rejected-as-noise" >&2
    return 2
  fi
  if ! have jq || ! have git; then
    echo "gate-ledger: episode-finding skipped (jq and git required)" >&2
    return 0
  fi

  local round; round=$(episode_round_get "$gate")
  if [ -z "$round" ]; then
    echo "gate-ledger: no open episode for gate '$gate' on this branch (run episode-open first)" >&2
    return 2
  fi
  local closed; closed=$(episode_verdict_get "$gate")
  local file; file="$(ledger_dir)/$(branch_slug).json"
  if [ -n "$closed" ]; then
    if [ "$closed" = "$EPISODE_RETRY_VERDICT" ]; then
      # The one door left open while the retry outcome rides: a set-aside
      # disposition (carried, waived, rejected-as-noise) of a fingerprint
      # ALREADY on the episode — what the escalation and cap refusals
      # prescribe ("waive what will not be fixed"). Without it those messages
      # pointed back at this same refusal, leaving episode-open — which
      # archives the very findings a waiver must land on — as the only exit.
      # Everything else still refuses: a fingerprint not on the episode, or
      # any non-set-aside status (open/closed are round work). What the door
      # admits still runs every downstream guard.
      local disposition_ok=""
      if finding_status_is_set_aside "$status"; then
        # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
        disposition_ok=$(jq -r --arg g "$gate" --arg fp "$fingerprint" \
          '.episodes[$g].findings[$fp] != null' "$file" 2>/dev/null)
      fi
      if [ "$disposition_ok" != "true" ]; then
        echo "gate-ledger: episode for gate '$gate' carries round outcome '$closed' —" \
             "run episode-round to re-enter its re-review before recording findings" \
             "(while that outcome rides, only a set-aside disposition — carried, waived, or" \
             "rejected-as-noise — of an already-recorded finding may land)" >&2
        return 1
      fi
    else
      echo "gate-ledger: episode for gate '$gate' is closed (verdict '$closed' recorded) —" \
           "findings record during a round, before its verdict; run episode-open for a fresh episode" >&2
      return 1
    fi
  fi
  case "$round" in
    *[!0-9]*) echo "gate-ledger: episode-finding: corrupted round '$round' for gate '$gate'" >&2; return 1 ;;
  esac

  local existing stored_severity stored_lane first_round classified
  existing=$(jq -c --arg g "$gate" --arg fp "$fingerprint" \
    '.episodes[$g].findings[$fp] // empty' "$file" 2>/dev/null)

  if [ -n "$existing" ]; then
    # Update path: identity (lane, severity, round) fixed at first record; only
    # status moves, regression classification is not relitigated.
    stored_severity=$(printf '%s' "$existing" | jq -r '.severity // ""')
    stored_lane=$(printf '%s' "$existing" | jq -r '.lane // ""')
    first_round=$(printf '%s' "$existing" | jq -r '.round // ""')
    classified=$(printf '%s' "$existing" | jq -r '.regressionOf // ""')
    # A stored record with no readable round is treated as if it were first
    # recorded THIS round — fail closed, so a corrupted record cannot buy its way
    # past rule 1 below by having no round to test.
    case "$first_round" in
      ''|*[!0-9]*) first_round="$round" ;;
    esac
    if [ -n "$severity" ] && [ "$severity" != "$stored_severity" ]; then
      echo "gate-ledger: episode-finding: severity is fixed at first record" \
           "('$stored_severity' for '$fingerprint') — a reclassification is a new finding" >&2
      return 2
    fi
    if [ -n "$lane" ] && [ "$lane" != "$stored_lane" ]; then
      echo "gate-ledger: episode-finding: lane is fixed at first record" \
           "('$stored_lane' for '$fingerprint')" >&2
      return 2
    fi
    if [ -n "$regression_of" ]; then
      echo "gate-ledger: --regression-of is set when a finding is first recorded, not on an update" >&2
      return 2
    fi
    severity="$stored_severity"
  else
    if [ -z "$lane" ] || [ -z "$severity" ]; then
      echo "gate-ledger: --lane and --severity required when first recording a finding" >&2
      return 2
    fi
    if [ -n "$regression_of" ]; then
      if [ "$round" -lt 2 ]; then
        echo "gate-ledger: --regression-of needs a prior round — this episode is still on round 1" >&2
        return 1
      fi
      local ref_round
      ref_round=$(jq -r --arg g "$gate" --arg fp "$regression_of" \
        '.episodes[$g].findings[$fp].round // empty' "$file" 2>/dev/null)
      if [ "$ref_round" != "1" ]; then
        echo "gate-ledger: --regression-of '$regression_of' does not name a round-1 finding of this episode" >&2
        return 1
      fi
    fi
    first_round="$round"
    classified="$regression_of"
  fi

  # Rule 1: round 2 may not widen the blocking set below Critical.
  #
  # Keyed on the round the finding was FIRST recorded, never the round doing
  # the recording, and checked on BOTH paths — a finding reaches `open` in two
  # calls as easily as one. Recording a round-2 finding `carried` then
  # re-recording it `open` used to land unrefused: the first call dodged the
  # rule on status, the second by being an update — a widened blocking set with
  # no --regression-of, defeating the convergence guard downstream.
  #
  # `classified` carries the regression classification from first record, so a
  # finding legitimately admitted round-2-as-regression stays updatable; a
  # round-1 finding restated as still-standing has first_round 1 and is out of
  # scope here.
  if [ "$first_round" -ge 2 ] && [ "$status" = "open" ] && [ "$severity" = "Important" ] \
     && [ -z "$classified" ]; then
    echo "gate-ledger: episode-finding refused — round $round fixes round 1, it does not widen the" \
         "blocking set: a new blocking finding below Critical must name --regression-of <round-1" \
         "fingerprint> (a new Critical, or a non-blocking Track, stays recordable)" >&2
    return 1
  fi

  # Rule 2: a Critical set aside (`carried`, `waived`, `rejected-as-noise` —
  # all ride through the verdict unfixed) needs a recorded waiver. Checked
  # against the STORED severity on an update, so it can't be dodged by
  # restating at a lower tier, and guarded on every set-aside status so no
  # sibling word dodges it either.
  if [ "$severity" = "Critical" ] && finding_status_is_set_aside "$status" && [ -z "$waiver" ]; then
    echo "gate-ledger: episode-finding refused — a Critical reaches '$status' only with" \
         "--waiver <reason>; fix it, or record why it is being set aside" >&2
    return 1
  fi

  # First record keeps its identity fields and round forever (`//` default only
  # materializes when the fingerprint is new); an update merges status/updatedAt
  # — and waiver, when given — over the stored record.
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  json_update "$file" \
    '.episodes[$g].findings[$fp] =
       ((.episodes[$g].findings[$fp]
           // {lane: $lane, severity: $sev, round: ($round | tonumber), recordedAt: $t})
        + {status: $status, updatedAt: $t}
        + (if $reg != "" then {regressionOf: $reg} else {} end)
        + (if $waiver != "" then {waiver: $waiver} else {} end))' \
    --arg g "$gate" --arg fp "$fingerprint" --arg lane "$lane" --arg sev "$severity" \
    --arg round "$round" --arg status "$status" --arg reg "$regression_of" \
    --arg waiver "$waiver" --arg t "$(now_iso)"
}

cmd_episode_get() { # --gate G [--findings | --history] [--branch B] -> one line a prose surface can quote verbatim: "round R of C — N open, M carried"
  # Findings ledger's read side. Counts only `open`/`carried` — what a verdict
  # has to answer for (`closed` resolved, `waived`/`rejected-as-noise` set
  # aside). Prints nothing when no episode is recorded, mirroring gate-get/epic-get.
  #
  # --findings (#289, injected into /review's next-round lane dispatches)
  # follows the summary with two fingerprint-sorted, tab-separated blocks —
  # compaction (#298) keeps inheritance a digest, not a transcript:
  #
  #   detail (open, carried):   <status>\t<severity>\t<lane>\t<fingerprint>
  #   digest (everything else): digest\t<lane>\t<fingerprint>\t<status>\t<round>
  #
  # SYNC NOTE: `scripts/retro-stats` (`lanes_section`) unpacks both layouts by
  # position. Change either column order here and update that unpacking too.
  #
  # A disposed finding costs one line — lane and fingerprint, the suppression
  # contract's (#292) two match keys, as fields rather than parsed out of a
  # naming convention.
  #
  # --history (#300): every archived episode plus the current one, each with
  # verdict, counts, escalation, and the waiver text the operator typed.
  #
  # --branch (#330): read another branch's episodes, same as gate-get and
  # evidence-list — `scripts/retro-stats` runs on main and reads every story
  # branch's record from there. Default stays the current branch.
  local gate="" findings=0 history=0 branch=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --gate)     gate="$2"; shift 2 ;;
      --findings) findings=1; shift ;;
      --history)  history=1; shift ;;
      --branch)   branch="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$gate" ]; then
    echo "gate-ledger: --gate required" >&2
    return 2
  fi
  if [ "$findings" -eq 1 ] && [ "$history" -eq 1 ]; then
    echo "gate-ledger: --findings and --history are separate reads; pass one" >&2
    return 2
  fi
  if ! have jq || ! have git; then return 0; fi
  local file; file="$(ledger_dir)/$(branch_slug "$branch").json"
  [ -f "$file" ] || return 0
  if [ "$history" -eq 1 ]; then
    # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
    jq -r --arg g "$gate" --arg cap "$EPISODE_ROUND_CAP" \
      '((.episodeHistory[$g] // []) | map({e: ., current: false}))
       + (if .episodes[$g] then [{e: .episodes[$g], current: true}] else [] end)
       | to_entries[]
       | (.key + 1) as $n | .value.current as $cur | .value.e as $e
       | (($e.findings // {}) | to_entries | sort_by(.key)) as $es
       | "episode \($n)\(if $cur then " (current)" else "" end) — opened \($e.openedAt // "?") at \($e.sha // "?"), round \($e.round) of \($cap), \(if $e.verdict then "verdict \($e.verdict)" else "no verdict yet" end) — \([$es[].value | select(.status == "open")] | length) open, \([$es[].value | select(.status == "carried")] | length) carried",
         (if $e.escalated then "escalated\tround \($e.escalated.round)\t\($e.escalated.blocking) blocking, prior round \($e.escalated.priorBlocking)" else empty end),
         ($es[] | select(.value.waiver) | "waiver\t\(.key)\t\(.value.status)\t\(.value.waiver)")' \
      "$file" 2>/dev/null
    return
  fi
  if [ "$findings" -eq 1 ]; then
    # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
    jq -r --arg g "$gate" --arg cap "$EPISODE_ROUND_CAP" \
      '.episodes[$g] // empty
       | ((.findings // {}) | to_entries | sort_by(.key)) as $es
       | ([$es[].value]) as $fs
       | "round \(.round) of \($cap) — \([$fs[] | select(.status == "open")] | length) open, \([$fs[] | select(.status == "carried")] | length) carried",
         ($es[] | select(.value.status == "open" or .value.status == "carried")
          | "\(.value.status)\t\(.value.severity)\t\(.value.lane)\t\(.key)"),
         ($es[] | select(.value.status != "open" and .value.status != "carried")
          | "digest\t\(.value.lane)\t\(.key)\t\(.value.status)\t\(.value.round)")' \
      "$file" 2>/dev/null
    return
  fi
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  jq -r --arg g "$gate" --arg cap "$EPISODE_ROUND_CAP" \
    '.episodes[$g] // empty
     | ((.findings // {}) | [.[]]) as $fs
     | "round \(.round) of \($cap) — \([$fs[] | select(.status == "open")] | length) open, \([$fs[] | select(.status == "carried")] | length) carried"' \
    "$file" 2>/dev/null
}

work_file_init() { # slug → ensures the work file exists, echoes its path
  local slug="$1"
  local dir; dir=$(store_dir work)
  mkdir -p "$dir"
  local file; file="$dir/$slug.json"
  [ -f "$file" ] || printf '{"schemaVersion":1,"slug":"%s","history":[]}' "$slug" > "$file"
  printf '%s' "$file"
}

cmd_work_set() {
  local slug="" title="" src="" branch="" doc="" phase="" declared="" declared_given=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug)           slug="$2"; shift 2 ;;
      --title)          title="$2"; shift 2 ;;
      --source)         src="$2"; shift 2 ;;
      --branch)         branch="$2"; shift 2 ;;
      --design-doc)     doc="$2"; shift 2 ;;
      --declared-files) declared="$2"; declared_given=1; shift 2 ;;
      --phase)          phase="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$slug" ]; then
    echo "gate-ledger: --slug required" >&2
    return 2
  fi
  if ! have jq || ! have git; then
    echo "gate-ledger: work-set skipped (jq and git required)" >&2
    return 0
  fi

  slug=$(slugify "$slug")
  if [ -z "$slug" ]; then
    echo "gate-ledger: --slug reduced to nothing after slugify" >&2
    return 2
  fi

  ensure_gitignore
  local file; file=$(work_file_init "$slug")
  local rc
  # Scope-delta measurement (#244): --declared-files is the design worker's own
  # forecast of exact files the story touches — a distinct field
  # (declaredFiles), never parsed from the design doc itself
  # (reference/design-doc-contract.md excludes file layout) and never a
  # directory prefix (exact paths only). An explicitly empty --declared-files
  # is a real declaration of zero files, not "not provided" — csv_trim maps it
  # to [] — so unlike every other optional field here, it's written whenever
  # the flag is present at all (`declared_given`), not only when non-empty,
  # letting a reader tell "declared nothing" from "never declared." `| unique`
  # matches the report side's treatment of `outsideFiles` — a repeated path
  # must not inflate `declared \(N)`.
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  json_update "$file" \
    'def csv_trim: split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""));
     .schemaVersion = (.schemaVersion // 1)
     | .createdAt = (.createdAt // $t)
     | .updatedAt = $t
     | (if $title    != "" then .title        = $title            else . end)
     | (if $src      != "" then .source       = $src              else . end)
     | (if $branch   != "" then .branch       = $branch           else . end)
     | (if $doc      != "" then .designDoc    = $doc              else . end)
     | (if $declGiven == "1" then .declaredFiles = ($decl | csv_trim | unique) else . end)
     | (if $phase    != "" then .phase        = $phase            else . end)' \
    --arg title "$title" --arg src "$src" --arg branch "$branch" \
    --arg doc "$doc" --arg decl "$declared" --arg declGiven "$declared_given" \
    --arg phase "$phase" --arg t "$(now_iso)"
  rc=$?

  return "$rc"
}

validate_work_log_args() { # step outcome sdPhase sdFilesGiven sdUnmeasured amendFile amendReason sdReason ->
  # cmd_work_log's seven argument-combination rules, extracted so the verb body
  # reads as one parse loop, one validation pass, one jq write. Pure: reads
  # only its positional args, returns non-zero on the FIRST violated rule.
  # `slug` is checked by the caller, not here.
  local step="$1" outcome="$2" sd_phase="$3" sd_files_given="$4" sd_unmeasured="$5" \
        amend_file="$6" amend_reason="$7" sd_reason="$8"
  # --step/--outcome are paired (both or neither) — optional on this verb
  # because scope-delta measurement (#244) needs a call recording nothing but
  # an outside-file count or an amendment, with no step of its own (a fixer
  # never had one). At least one of a step/outcome pair, a scope-delta write,
  # or an amendment must be present.
  if { [ -n "$step" ] && [ -z "$outcome" ]; } || { [ -z "$step" ] && [ -n "$outcome" ]; }; then
    echo "gate-ledger: --step and --outcome must be given together" >&2
    return 1
  fi
  if { [ -n "$amend_file" ] && [ -z "$amend_reason" ]; } || { [ -z "$amend_file" ] && [ -n "$amend_reason" ]; }; then
    echo "gate-ledger: --amend-file and --amend-reason must be given together" >&2
    return 1
  fi
  if [ "$sd_files_given" -eq 1 ] && [ "$sd_unmeasured" -eq 1 ]; then
    echo "gate-ledger: --scope-delta-files and --scope-delta-unmeasured are mutually exclusive" >&2
    return 1
  fi
  if { [ "$sd_files_given" -eq 1 ] || [ "$sd_unmeasured" -eq 1 ] || [ -n "$amend_file" ]; } && [ -z "$sd_phase" ]; then
    echo "gate-ledger: --scope-delta-phase required with --scope-delta-files, --scope-delta-unmeasured, or --amend-file" >&2
    return 1
  fi
  # Fix-and-retry finding 3 (#244): --scope-delta-reason names WHY a moment is
  # unmeasured, meaningless otherwise — reject it alone or paired with
  # --scope-delta-files.
  if [ -n "$sd_reason" ] && [ "$sd_unmeasured" -ne 1 ]; then
    echo "gate-ledger: --scope-delta-reason requires --scope-delta-unmeasured" >&2
    return 1
  fi
  if [ -z "$step" ] && [ "$sd_files_given" -eq 0 ] && [ "$sd_unmeasured" -eq 0 ] && [ -z "$amend_file" ]; then
    echo "gate-ledger: nothing to record — give --step/--outcome, --scope-delta-phase (with --scope-delta-files or --scope-delta-unmeasured), or --amend-file/--amend-reason" >&2
    return 1
  fi
  return 0
}

cmd_work_log() {
  local slug="" step="" outcome="" phase="" \
        sd_phase="" sd_files="" sd_files_given=0 sd_unmeasured=0 sd_reason="" \
        amend_file="" amend_reason=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug)                  slug="$2"; shift 2 ;;
      --step)                  step="$2"; shift 2 ;;
      --outcome)                outcome="$2"; shift 2 ;;
      --phase)                 phase="$2"; shift 2 ;;
      --scope-delta-phase)     sd_phase="$2"; shift 2 ;;
      --scope-delta-files)     sd_files="$2"; sd_files_given=1; shift 2 ;;
      --scope-delta-unmeasured) sd_unmeasured=1; shift ;;
      --scope-delta-reason)    sd_reason="$2"; shift 2 ;;
      --amend-file)            amend_file="$2"; shift 2 ;;
      --amend-reason)          amend_reason="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$slug" ]; then
    echo "gate-ledger: --slug required" >&2
    return 2
  fi
  validate_work_log_args "$step" "$outcome" "$sd_phase" "$sd_files_given" "$sd_unmeasured" \
    "$amend_file" "$amend_reason" "$sd_reason" || return 2
  # Per-step outcome vocabulary. Only a step whose *reader* branches on the
  # token is constrained; gate steps carry verdicts owned by
  # reference/gate-vocabulary.md and stay free-form, as do markers like
  # run-boundary. `build` is constrained because commands/next.md's
  # "Executor-reported build status" check branches on exactly these, and
  # three writers had drifted into two dialects with nothing to catch it
  # (#213). Scope-delta measurement (#244) rides its own dedicated fields so
  # it never has to widen this closed list.
  #   BUILT | PAUSED | ESCALATED  executor-reported terminal status (worker-contract.md)
  #   HANDED-OFF | SKIPPED        /next's own non-terminal flow markers
  if [ "$step" = "build" ]; then
    case "$outcome" in
      BUILT|PAUSED|ESCALATED|HANDED-OFF|SKIPPED) ;;
      *)
        echo "gate-ledger: --step build --outcome '$outcome' is not a recognized status;" \
             "use BUILT, PAUSED, ESCALATED, HANDED-OFF, or SKIPPED" \
             "(reference/worker-contract.md, Status reporting)" >&2
        return 2
        ;;
    esac
  fi
  # Fix-and-retry finding 3 (#244): --scope-delta-reason's own closed
  # vocabulary, same posture as --step build --outcome above. Optional: an
  # omitted reason still writes a valid unmeasured entry, so this fires only when given.
  if [ -n "$sd_reason" ]; then
    case "$sd_reason" in
      dispatch-failed|no-declaration|unsafe-path) ;;
      *)
        echo "gate-ledger: --scope-delta-reason '$sd_reason' is not a recognized reason;" \
             "use dispatch-failed, no-declaration, or unsafe-path" >&2
        return 2
        ;;
    esac
  fi
  if ! have jq || ! have git; then
    echo "gate-ledger: work-log skipped (jq and git required)" >&2
    return 0
  fi

  slug=$(slugify "$slug")
  if [ -z "$slug" ]; then
    echo "gate-ledger: --slug reduced to nothing after slugify" >&2
    return 2
  fi

  ensure_gitignore
  local file; file=$(work_file_init "$slug")
  local sha rc
  sha="$(head_sha)"
  # Scope-delta measurement (#244): `.scopeDelta` is an append-only log of
  # per-moment measurements — never rewritten, never summed here (readers do
  # that from the entries). `.amendments`
  # is a separate append-only list keyed by file, justifying a file some moment
  # already counted outside the declaration. Neither ever edits a prior entry
  # in either array, or touches `.history`/`$outcome`. `unmeasured: true`
  # carries an empty `outsideFiles` so every entry has the same shape — the
  # boolean, not the array, is what a reader branches on; "unmeasured" and
  # "measured zero" are different facts. `reason` (fix-and-retry finding 3,
  # #244) is present only on an unmeasured entry that gave
  # `--scope-delta-reason`; a missing key means "unspecified," never a parse failure.
  local sd_write=0
  if [ "$sd_files_given" -eq 1 ] || [ "$sd_unmeasured" -eq 1 ]; then
    sd_write=1
  fi
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  json_update "$file" \
    'def csv_trim: split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""));
     (if $step != "" then .history = ((.history // []) + [{step: $step, outcome: $outcome, sha: $s, at: $t}]) else . end)
     | .updatedAt = $t
     | (if $phase != "" then .phase = $phase else . end)
     | (if $sdWrite == "1" then
         .scopeDelta = ((.scopeDelta // []) + [
           ({phase: $sdPhase, unmeasured: ($sdUnmeasured == "1"),
             outsideFiles: (if $sdUnmeasured == "1" then [] else ($sdFiles | csv_trim) end),
             sha: $s, at: $t}
            + (if $sdUnmeasured == "1" and $sdReason != "" then {reason: $sdReason} else {} end))])
       else . end)
     | (if $amendFile != "" then
         .amendments = ((.amendments // []) + [{file: $amendFile, phase: $sdPhase, reason: $amendReason, at: $t}])
       else . end)' \
    --arg step "$step" --arg outcome "$outcome" --arg phase "$phase" \
    --arg sdPhase "$sd_phase" --arg sdFiles "$sd_files" \
    --arg sdWrite "$sd_write" --arg sdUnmeasured "$sd_unmeasured" --arg sdReason "$sd_reason" \
    --arg amendFile "$amend_file" --arg amendReason "$amend_reason" \
    --arg s "$sha" --arg t "$(now_iso)"
  rc=$?

  return "$rc"
}

cmd_work_get() {
  local slug=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug) slug="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$slug" ]; then
    echo "gate-ledger: --slug required" >&2
    return 2
  fi
  slug=$(slugify "$slug")
  local file; file="$(store_dir work)/$slug.json"
  [ -f "$file" ] || return 0
  cat "$file"
}


cmd_work_list() {
  if ! have jq; then return 0; fi
  local dir; dir=$(store_dir work)
  local f
  for f in "$dir"/*.json; do
    [ -e "$f" ] || continue
    jq -r '[(.slug // "?"), (.phase // "?"), (.branch // "-"), (.title // "-")] | @tsv' "$f" 2>/dev/null
  done
}

# Scope-delta measurement (#244) acceptance fix-and-retry: how long cmd_gc's
# measured-scope-delta guard (below) keeps a work file before collecting it
# regardless. Bounded, not permanent — the guard's first cut (`kept ... unless
# --force`) had no terminating condition, silently re-disabling #237's fix on
# the exact files it was written for. Read-marking was rejected: `work-get` is
# called constantly by in-flow fact-checks, so marking "read" there would
# defeat the guard before a human ever saw the cohort. A per-slug opt-out was rejected as `--force` at file granularity —
# still a manual action per file. Bounded retention needs neither: plain `gc`
# collects on its own once the window lapses. Not a flag — a configurable
# threshold is a second knob nobody asked for; this constant is the whole knob.
SCOPE_DELTA_RETENTION_DAYS=14

scope_delta_retention_lapsed() { # file -> true (exit 0) once its last write is older than the keep window; false (exit 1) otherwise, and fail toward keeping (false) on any read failure or missing timestamp
  local file="$1" updated
  updated=$(jq -r '.updatedAt // .createdAt // empty' "$file" 2>/dev/null)
  [ -n "$updated" ] || return 1
  jq -n -e --arg u "$updated" --argjson days "$SCOPE_DELTA_RETENTION_DAYS" \
    '(try (now - ($u | fromdateiso8601)) catch null) as $age
     | $age != null and $age > ($days * 86400)' >/dev/null 2>&1
}

cmd_gc() {
  # Scope-delta measurement (#244), pre-mortem register item 7 (REALIZED): a
  # work file is the only copy of `declaredFiles`/`scopeDelta`/`amendments` —
  # collecting it discards that story's measurement cohort for good. `--force`
  # opts back into unconditional collection; without it, a work file that
  # would otherwise be collected but still carries at least one *measured*
  # `.scopeDelta` moment (`unmeasured: true` carries no file data by
  # construction, so an all-unmeasured cohort has nothing to save; narrowing on
  # measured entries rather than `declaredFiles != null` keeps a
  # fallback-driven epic's unmeasured-only moments from pinning every file it
  # touches) is kept instead, named in the output. The keep is bounded by
  # SCOPE_DELTA_RETENTION_DAYS above.
  local force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      *) echo "gate-ledger: gc: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if ! have jq || ! have git; then return 0; fi
  local dir; dir=$(ledger_dir)
  local f branch
  for f in "$dir"/*.json; do
    [ -e "$f" ] || continue
    branch=$(jq -r '.branch // empty' "$f" 2>/dev/null)
    [ -n "$branch" ] || continue
    if ! git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null 2>&1; then
      rm -f "$f"
      printf 'removed stale ledger: %s (branch %s no longer exists)\n' "$(basename "$f")" "$branch"
    fi
  done

  # Work files: two independent collection rules, either one sufficient.
  #
  #   1. The branch is gone. The flow it tracked cannot be resumed.
  #   2. The phase is terminal (`done`/`stopped`). A finished flow has no
  #      position left to track; the durable record is commit history, the PR,
  #      and the pre-mortem register.
  #
  # Rule 2 exists because rule 1 alone couldn't fire when a landed story's
  # branch is deliberately kept (#237): so its work file stayed pinned
  # at phase `merge` and `/next` counted it active. A work file with no branch
  # yet (decide/design) is kept unless its phase is terminal.
  #
  # Scope-delta measurement (#244) fix-and-retry, finding 2: the
  # measured-scope-delta guard below applies to rule 2 ONLY, never rule 1 — a
  # deliberate asymmetry. A story parked and then abandoned (branch deleted)
  # never reached acceptance, so its cohort is incomplete and can't feed the
  # success-metric read the guard protects. Guarding rule 1 too was tried and
  # reverted: commands/next.md selects by phase alone, so a rule-1 file the
  # guard kept pinned stayed counted Active in commands/doctor.md's >10
  # threshold — reintroducing #237's symptom to protect data nothing reads.
  #
  # This guard reads `.scopeDelta`, populated only by `work-set
  # --declared-files` and `work-log --scope-delta-*`. Rolling back just those
  # two writers leaves this guard and its three conditional printf messages
  # reading a field nothing populates: `sd_len` computes to 0 everywhere, the
  # guard never arms, and `gc` silently reverts to the pre-#237 regression with
  # no visible symptom. Roll back this whole block
  # (`scope_delta_retention_lapsed` included) and the five `.scopeDelta` spots
  # in `commands/studious-doctor.md` together, or the rollback is incomplete.
  local wdir; wdir=$(store_dir work)
  local phase sd_len slug
  for f in "$wdir"/*.json; do
    [ -e "$f" ] || continue
    branch=$(jq -r '.branch // empty' "$f" 2>/dev/null)
    phase=$(jq -r '.phase // empty' "$f" 2>/dev/null)
    sd_len=$(jq -r '(.scopeDelta // []) | map(select(.unmeasured != true)) | length' "$f" 2>/dev/null)
    slug=$(basename "$f" .json)
    if [ "$phase" = "done" ] || [ "$phase" = "stopped" ]; then
      # Fix-and-retry finding 4 (#244 round 9): the read path the retention exists for.
      if [ "$force" -ne 1 ] && [ -n "$sd_len" ] && [ "$sd_len" != "0" ] && ! scope_delta_retention_lapsed "$f"; then
        printf 'kept: %s still holds %s measured scope-delta moment(s) — gate-ledger work-get --slug "%s" to read it, gc --force to collect now, or plain gc collects it %s days after its last write\n' \
          "$slug" "$sd_len" "$slug" "$SCOPE_DELTA_RETENTION_DAYS"
        continue
      fi
      rm -f "$f"
      if [ -n "$sd_len" ] && [ "$sd_len" != "0" ] && [ "$force" -eq 1 ]; then
        printf 'removed finished work file: %s (phase %s, --force discarded %s measured scope-delta moment(s))\n' \
          "$(basename "$f")" "$phase" "$sd_len"
      elif [ "$force" -ne 1 ] && [ -n "$sd_len" ] && [ "$sd_len" != "0" ]; then
        printf 'removed work file past its %s-day scope-delta keep window: %s (phase %s, %s measured scope-delta moment(s) recorded)\n' \
          "$SCOPE_DELTA_RETENTION_DAYS" "$(basename "$f")" "$phase" "$sd_len"
      else
        printf 'removed finished work file: %s (phase %s)\n' "$(basename "$f")" "$phase"
      fi
    elif [ -n "$branch" ] && ! git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null 2>&1; then
      # No scope-delta guard here — see this function's own comment above for
      # why rule 1 (branch gone) stays unconditional while rule 2 (terminal
      # phase) above does not.
      rm -f "$f"
      printf 'removed stale work file: %s (branch %s no longer exists)\n' "$(basename "$f")" "$branch"
    fi
  done

}

cmd_evidence_append() { # append-only: one jq -nc object per call, >> the branch's .jsonl
  local command="" exit_code="" output_digest="" origin="" agent_type=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --command)       command="$2"; shift 2 ;;
      --exit-code)     exit_code="$2"; shift 2 ;;
      --output-digest) output_digest="$2"; shift 2 ;;
      --origin)        origin="$2"; shift 2 ;;
      --agent-type)    agent_type="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$command" ] || [ -z "$exit_code" ] || [ -z "$output_digest" ] || [ -z "$origin" ]; then
    echo "gate-ledger: --command, --exit-code, --output-digest, and --origin required" >&2
    return 2
  fi
  case "$exit_code" in
    ''|*[!0-9]*) echo "gate-ledger: --exit-code must be a non-negative integer" >&2; return 2 ;;
  esac
  case "$origin" in
    interactive|subagent) ;;
    *) echo "gate-ledger: --origin must be 'interactive' or 'subagent'" >&2; return 2 ;;
  esac
  if ! have jq || ! have git; then
    echo "gate-ledger: evidence-append skipped (jq and git required)" >&2
    return 0
  fi

  ensure_gitignore
  local dir; dir=$(store_dir evidence)
  mkdir -p "$dir"
  local file; file="$dir/$(branch_slug).jsonl"

  # capturer is hardcoded, never a caller-supplied flag, so a caller can't
  # spoof a different one. predicateType/predicate.configuration are fixed to
  # the one in-toto test-result shape (reference/evidence-format.md), not exposed as flags in v0.
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  jq -nc \
    --arg capturedAt "$(now_iso)" --arg origin "$origin" --arg agentType "$agent_type" \
    --arg command "$command" --argjson exitCode "$exit_code" --arg outputDigest "$output_digest" \
    '{capturedAt: $capturedAt, capturer: "hook", origin: $origin}
     + (if $agentType != "" then {agentType: $agentType} else {} end)
     + {command: $command, exitCode: $exitCode, outputDigest: $outputDigest,
        predicateType: "https://in-toto.io/attestation/test-result/v0.1",
        predicate: {result: (if $exitCode == 0 then "PASSED" else "FAILED" end),
                    configuration: [{name: $command}]}}' >> "$file"
}

cmd_evidence_list() { # optional --branch B: print that branch's evidence .jsonl verbatim; optional --dedupe: collapse to one record per distinct command (most recent wins), nothing if absent
  local branch="" dedupe=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --branch) branch="$2"; shift 2 ;;
      --dedupe) dedupe=1; shift ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  # Same store_dir(evidence)/branch_slug() anchoring evidence-append uses.
  # Named generically on purpose: shared bookkeeping on the guarded surface
  # never names a producer door. Mirrors cmd_gate_get's shape: resolve one
  # branch's file, print it verbatim, nothing if absent.
  local slug; slug=$(branch_slug "$branch")
  local file; file="$(store_dir evidence)/$slug.jsonl"
  [ -f "$file" ] || return 0

  if [ -z "$dedupe" ]; then
    # Never requires jq: reading and emitting the raw file needs no JSON parsing.
    cat "$file"
    return 0
  fi

  # --dedupe: keep one record per distinct `command` value (the one appended
  # last), in original chronological order. Index-based (to_entries/reduce
  # over a command->last-index map), deliberately not unique_by (reorders
  # alphabetically) or whole-object equality (latent bug: two records
  # byte-identical in every field, capturedAt included, would both survive).
  # See docs/studious/premortems/2026-07-21-evidence-list-dedupe-design.md.
  # Fails closed: no jq or a malformed line means no stdout, non-zero exit.
  if ! have jq; then
    echo "gate-ledger: evidence-list --dedupe requires jq" >&2
    return 1
  fi
  jq -c -s 'to_entries as $es
    | (reduce $es[] as $e ({}; .[$e.value.command] = $e.key)) as $last_idx
    | $es[] | select(.key == $last_idx[.value.command]) | .value' \
    "$file" \
    || { echo "gate-ledger: evidence-list --dedupe failed to parse $file" >&2; return 1; }
}

case "${1:-}" in
  record)          shift; cmd_record "$@" ;;
  status)          shift; cmd_status "$@" ;;
  gate-get)        shift; cmd_gate_get "$@" ;;
  episode-open)    shift; cmd_episode_open "$@" ;;
  episode-round)   shift; cmd_episode_round "$@" ;;
  episode-verdict) shift; cmd_episode_verdict "$@" ;;
  episode-finding) shift; cmd_episode_finding "$@" ;;
  episode-get)     shift; cmd_episode_get "$@" ;;
  work-set)        shift; cmd_work_set "$@" ;;
  work-log)        shift; cmd_work_log "$@" ;;
  work-get)        shift; cmd_work_get "$@" ;;
  work-list)       shift; cmd_work_list "$@" ;;
  evidence-append) shift; cmd_evidence_append "$@" ;;
  evidence-list)   shift; cmd_evidence_list "$@" ;;
  gc)              shift; cmd_gc "$@" ;;
  *) echo "usage: gate-ledger {record --gate G --verdict V [--blocking-lanes L1,L2] | status | gate-get [--branch B] | episode-open --gate G | episode-round --gate G | episode-verdict --gate G --verdict V [--blocking-lanes L1,L2] | episode-finding --gate G --fingerprint F --status open|closed|carried|waived|rejected-as-noise [--lane L] [--severity Critical|Important|Track] [--regression-of FP] [--waiver R] | episode-get --gate G [--findings | --history] [--branch B] | work-set --slug S [--title T] [--source SRC] [--branch B] [--design-doc P] [--declared-files F1,F2] [--phase PH] | work-log --slug S ([--step ST --outcome O] | --scope-delta-phase PH2 (--scope-delta-files F1,F2 | --scope-delta-unmeasured [--scope-delta-reason dispatch-failed|no-declaration|unsafe-path]) | --amend-file F --amend-reason R) [--phase PH] | work-get --slug S | work-list | evidence-append --command C --exit-code N --output-digest D --origin interactive|subagent [--agent-type T] | evidence-list [--branch B] [--dedupe] | gc [--force]}" >&2; exit 2 ;;
esac
