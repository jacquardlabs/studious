#!/usr/bin/env bash
# gate-ledger — read/write Studious's local, gitignored .studious/ state.
#
# Five stores in the consuming project:
#   .studious/gates/<branch-slug>.json  — per-branch gate verdicts. Written by the
#     gate commands (via `record`); read by the PR-time hook (via `status`) and by
#     /work-on's evidence check (via `gate-get`) — never read as a raw file by callers.
#     The same file also carries `episodes` (#289): one bounded gate episode per
#     gate, written via `episode-open`/`episode-round`/`episode-verdict` — see
#     those verbs for the record's schema. `status` and every other legacy reader
#     branch only on `.branch`/`.gates`, so the object rides along inertly.
#     A gate's entry optionally carries `blockingLanes` (delta-scoped re-audit, #130):
#     set only via `record --gate audit --blocking-lanes L1,L2` when the audit verdict
#     is FIX AND RE-AUDIT; read back via `gate-get` by commands/gate-audit.md and
#     workflows/epic-driver.js to narrow the *next* re-audit's dispatch width. Absent on
#     every other verdict and on every record written before this field existed —
#     indistinguishable from "malformed," which both readers fail closed on (full audit).
#   .studious/work/<feature-slug>.json  — per-feature flow position for /work-on
#     (written via `work-set` / `work-log`; read via `work-get` / `work-list`).
#     Optional scope-delta measurement fields (#244), epic-driven path only:
#     `declaredFiles` — the design worker's own forecast of exact files this story
#     expects to touch, set alongside `--design-doc` via `work-set --declared-files`;
#     absent means no declaration was ever recorded (measured as `unmeasured`, never
#     zero). `scopeDelta` — an append-only array, one entry per moment the driver
#     measured (`{phase, unmeasured, outsideFiles, sha, at}`, plus `reason` —
#     `dispatch-failed`/`no-declaration`/`unsafe-path` — on an unmeasured entry
#     only, fix-and-retry finding 3, #244), written via `work-log
#     --scope-delta-phase P (--scope-delta-files F1,F2 | --scope-delta-unmeasured
#     [--scope-delta-reason R])`. `amendments` — a separate append-only array
#     (`{file, phase, reason, at}`) attaching a one-line justification to a file some
#     `scopeDelta` entry already counted as outside the declaration; an amendment
#     never removes or edits a `scopeDelta` entry and never changes any count — see
#     the design doc this story's SHA cites for the full mechanism.
#   .studious/epics/<epic-slug>.json  — per-epic plan and story DAG for /work-through (written via epic-set / epic-story-set; read via epic-get / epic-list).
#   .studious/epics/<epic-slug>.events.jsonl — append-only status-transition and
#     verdict-recording trail for stories running under that epic (one JSON object
#     per line, appended by the shared `append_event()` helper from `record`,
#     `epic-set`, `epic-story-set`, `work-set`, and `work-log` — see
#     reference/events-format.md). Epic/story attribution is derived from the
#     branch name or the epic-qualified `--slug` convention those verbs already
#     use, never a new flag. Best-effort: a failure appending a line signals on
#     stderr but never fails the calling verb's own exit code — no reader exists
#     yet (a later, dependent story is the first).
#   .studious/evidence/<branch-slug>.jsonl — append-only, harness-captured record
#     of verification commands run while a story is armed (one JSON object per
#     line; written via `evidence-append` by hooks/evidence-capture.sh; read via
#     `evidence-list` — see reference/evidence-format.md).
# All five stores are anchored to the MAIN working tree (see repo_root), so
# agents running in linked worktrees (e.g. /work-through story worktrees)
# share one .studious/ store instead of fragmenting it per worktree.
#
# Alongside the five stores, .studious/worktrees/<epic-slug>/ holds /work-through's
# checkouts — `__epic` for the integration worktree, one directory per in-flight
# story. This script owns that layout (worktree_path); everyone else asks for a
# path via the `worktree-path` verb rather than composing one.
# Degrades silently when git or jq is unavailable.
set -uo pipefail

branch_name() { git rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD; }
branch_slug() { local b; b="${1:-$(branch_name)}"; printf '%s' "${b//\//-}"; } # optional arg: slug for a given branch instead of the current one
head_sha()    { git rev-parse --short HEAD 2>/dev/null || echo ""; }
now_iso()     { date -u +%Y-%m-%dT%H:%M:%SZ; }

have() { command -v "$1" >/dev/null 2>&1; }

repo_root() {
  # Anchor state to the MAIN working tree so agents running in linked
  # worktrees (e.g. /work-through story worktrees) share one .studious/ store.
  local common
  common=$(git rev-parse --git-common-dir 2>/dev/null) || return 1
  common=$(cd "$common" 2>/dev/null && pwd) || return 1  # may be relative ".git"
  case "$common" in
    */.git) printf '%s' "${common%/.git}" ;;
    *) git rev-parse --show-toplevel 2>/dev/null ;;  # bare/odd layouts: old behavior
  esac
}

ledger_dir() {
  # Anchor to the main working tree root so the ledger location doesn't
  # depend on the caller's CWD or which linked worktree it's running in.
  # Degrade to a CWD-relative path if we're not in a git repo at all.
  local root
  if root=$(repo_root); then
    printf '%s/.studious/gates' "$root"
  else
    printf '.studious/gates'
  fi
}

work_dir() {
  # Same root-anchoring as ledger_dir, different store.
  local root
  if root=$(repo_root); then
    printf '%s/.studious/work' "$root"
  else
    printf '.studious/work'
  fi
}

epic_dir() {
  # Same root-anchoring as ledger_dir, different store.
  local root
  if root=$(repo_root); then
    printf '%s/.studious/epics' "$root"
  else
    printf '.studious/epics'
  fi
}

evidence_dir() {
  # Same root-anchoring as ledger_dir, different store. A story worker running
  # in a linked worktree (its own cwd) still lands its records in the MAIN
  # tree's .studious/evidence/, exactly like the other three stores.
  local root
  if root=$(repo_root); then
    printf '%s/.studious/evidence' "$root"
  else
    printf '.studious/evidence'
  fi
}

worktree_path() { # <repo-root> <epic-slug> [<story-slug>] -> that worktree's absolute path
  # THE owner of /work-through's worktree layout: `.studious/worktrees/<epic>/`
  # holds one checkout per in-flight story plus `__epic`, the integration
  # checkout the stories merge into. Everything that needs one of these paths
  # goes through here — cmd_epic_reconcile's designDocExists lookup below, the
  # `worktree-path` verb, and (via that verb, across the args boundary)
  # workflows/epic-driver.js and commands/work-through.md — so the layout has
  # one definition to change instead of four to keep in step (#166).
  #
  # Pure string composition: no git, no epic file, no filesystem check. Callers
  # resolving a path for a worktree that may not exist yet — `git worktree add`
  # in work-through.md's step 5 runs before any of this exists on disk — depend
  # on that.
  #
  # `__epic` cannot collide with a story: slugify()'s `tr -cs 'a-z0-9' '-'`
  # rewrites every non-alphanumeric character, so an underscore survives nowhere
  # in a story key — `__epic` itself would slugify to `epic`. The sentinel and
  # the story keys share a namespace safely.
  #
  # Neither slug is normalized here. Slugify happens at the verb boundary
  # (cmd_worktree_path), exactly as it does for every sibling verb; the two
  # in-process callers pass keys read straight out of the stored epic file,
  # which epic-set and epic-story-set already slugified on the way in.
  local root="$1" epic_slug="$2" story="${3:-__epic}"
  printf '%s/.studious/worktrees/%s/%s' "$root" "$epic_slug" "$story"
}

slugify() {
  # Feature title/slug → filesystem- and JSON-safe key: lowercase, runs of
  # anything outside [a-z0-9] collapse to '-', edges trimmed.
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//; s/-*$//'
}

epic_context_from_branch() { # branch name -> prints "epicSlug<TAB>storySlug", nothing if not epic-shaped
  # workflows/epic-driver.js's storyBranch() names the convention: epic/<slug>--<story>
  # for a story branch, epic/<slug> for the epic's own integration branch. Both halves
  # were already slugified before the branch was created, so splitting the remainder on
  # the *first* "--" is unambiguous (see reference/events-format.md).
  local b="$1" rest
  case "$b" in
    epic/*) rest="${b#epic/}" ;;
    *) return 0 ;;  # no epic/ prefix at all: not an epic-dispatched branch, silent no-op
  esac
  case "$rest" in
    *--*) printf '%s\t%s' "${rest%%--*}" "${rest#*--}" ;;
    *)    printf '%s\t' "$rest" ;;  # the epic's own integration branch: epic-level event
  esac
}

epic_context_from_slug() { # raw (pre-slugify) --slug value -> prints "epicSlug<TAB>storySlug", nothing if not epic-qualified
  # Must run on the RAW argument, before the caller's own slug=$(slugify "$slug")
  # reassignment: slugify() collapses "--" to a single "-", which would make this
  # split a silent, permanent no-op if run after (see reference/events-format.md).
  case "$1" in
    *--*) printf '%s\t%s' "${1%%--*}" "${1#*--}" ;;
    *)    return 0 ;;  # never-epic-qualified /work-on feature slug: silent no-op
  esac
}

ensure_gitignore() {
  # Self-heal: keep .studious/ out of the user's git status, even for projects
  # initialized before the ledger existed. Anchored to the main working tree
  # (see repo_root) so a linked worktree self-heals the main .gitignore, not
  # its own.
  local root gi
  root=$(repo_root) || return 0
  gi="$root/.gitignore"
  if [ ! -f "$gi" ] || ! grep -qxF '.studious/' "$gi" 2>/dev/null; then
    printf '\n# Studious local gate ledger (do not commit)\n.studious/\n' >> "$gi"
  fi
}

json_update() { # file, jq filter, then any --arg name value ... pairs for jq
  # Shared writer for every mutating verb: run jq against $file into a
  # same-directory temp file, then rename the temp file over $file on
  # success. Same all-or-nothing outcome as a hand-written block — $file is
  # either untouched or fully replaced with valid jq output — and the same
  # failure behavior: a failing filter leaves $file untouched and the real
  # (non-zero) exit code propagates to the caller.
  #
  # Deliberately no RETURN trap here: a trap armed inside this function
  # doesn't stay scoped to it — bash re-fires it when the *calling* verb
  # itself returns, and by then this function's own $tmp has gone out of
  # scope. Under this script's `set -u`, that's an "unbound variable" abort
  # that would clobber the verb's real (already-succeeded) exit status.
  # Cleanup below is an explicit branch instead, so nothing fires after this
  # function has already returned.
  local file="$1" filter="$2"
  shift 2
  local dir tmp rc
  dir=$(dirname -- "$file")
  tmp=$(mktemp "$dir/.tmp.XXXXXX")
  # Capture $? from the compound command as its own statement, not as the
  # condition of an `if`: POSIX defines the exit status of an `if` with no
  # executed branch (condition false, no `else`) as zero, which would
  # silently discard a real jq/mv failure here and report success.
  jq "$@" "$filter" "$file" > "$tmp" && mv "$tmp" "$file"
  rc=$?
  if [ "$rc" -eq 0 ]; then
    return 0
  fi
  rm -f "$tmp"
  return "$rc"
}

append_event() { # epic, story, kind, jq-object filter for the kind's own fields, then --arg/--argjson pairs for it
  # The append-only counterpart to json_update()'s role: one jq -nc object per
  # call, >> the epic's shared .events.jsonl — same precedent as
  # cmd_evidence_append, no read-modify-write. Best-effort and silent on the
  # happy path: called only after the caller's own primary snapshot write has
  # already succeeded, and a failure here signals on stderr but always returns
  # 0 — this is a secondary, additive log, never a precondition for the
  # primary write it follows (see reference/events-format.md).
  local epic="$1" story="$2" kind="$3" fields="$4"
  shift 4
  if ! have jq || ! have git; then return 0; fi
  local dir; dir=$(epic_dir)
  mkdir -p "$dir" 2>/dev/null
  local file="$dir/$epic.events.jsonl"
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  if ! jq -nc "$@" \
      --arg at "$(now_iso)" --arg epic "$epic" --arg story "$story" --arg kind "$kind" \
      '{at: $at, epic: $epic, story: $story, kind: $kind} + ('"$fields"')' >> "$file" 2>/dev/null
  then
    echo "gate-ledger: events-append failed for epic '$epic' (kind $kind) — primary write unaffected" >&2
  fi
  return 0
}

gates_file_init() { # ensures the current branch's gates file exists, echoes its path
  local dir; dir=$(ledger_dir)
  mkdir -p "$dir"
  local file; file="$dir/$(branch_slug).json"
  [ -f "$file" ] || printf '{"schemaVersion":1,"branch":"","gates":{}}' > "$file"
  printf '%s' "$file"
}

cmd_record() {
  local gate="" verdict="" blocking_lanes=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --gate)            gate="$2"; shift 2 ;;
      --verdict)         verdict="$2"; shift 2 ;;
      --blocking-lanes)  blocking_lanes="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$gate" ] || [ -z "$verdict" ]; then
    echo "gate-ledger: --gate and --verdict required" >&2
    return 2
  fi
  if ! have jq || ! have git; then
    echo "gate-ledger: record skipped (jq and git required)" >&2
    return 0
  fi

  ensure_gitignore
  local file; file=$(gates_file_init)

  local branch sha rc
  branch="$(branch_name)"
  sha="$(head_sha)"
  # blockingLanes (delta-scoped re-audit, #130): a comma-separated
  # --blocking-lanes list is trimmed/deduped into a JSON array and added to
  # this gate's entry ONLY when given non-empty — every `record` call fully
  # replaces the gate's entry (see .gates[$g] = {...} below), so a verdict
  # recorded WITHOUT --blocking-lanes (a PASS, or a caller that never
  # computed one) correctly leaves the field absent rather than carrying a
  # stale list forward. Absence is exactly the "malformed/unavailable" signal
  # commands/gate-audit.md's and workflows/epic-driver.js's re-audit-scope
  # readers already fail closed on.
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  json_update "$file" \
    'def csv_trim: split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""));
     .schemaVersion = (.schemaVersion // 1)
     | .branch = $b
     | .gates[$g] = ({verdict: $v, sha: $s, ranAt: $t}
         + (if $bl != "" then {blockingLanes: ($bl | csv_trim)} else {} end))' \
    --arg b "$branch" --arg g "$gate" --arg v "$verdict" \
    --arg s "$sha" --arg t "$(now_iso)" --arg bl "$blocking_lanes"
  rc=$?

  if [ "$rc" -eq 0 ]; then
    local ctx epicSlug storySlug
    ctx=$(epic_context_from_branch "$branch")
    if [ -n "$ctx" ]; then
      IFS=$'\t' read -r epicSlug storySlug <<< "$ctx"
      # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
      append_event "$epicSlug" "$storySlug" "gate-verdict" '{gate: $gate, verdict: $verdict, sha: $sha}' \
        --arg gate "$gate" --arg verdict "$verdict" --arg sha "$sha"
    fi
  fi
  return "$rc"
}

cmd_status() {
  if ! have jq || ! have git; then return 0; fi
  local dir; dir=$(ledger_dir)
  local file; file="$dir/$(branch_slug).json"
  [ -f "$file" ] || return 0

  local head cur_branch stored_branch branch_mismatch
  head=$(head_sha)
  cur_branch=$(branch_name)
  stored_branch=$(jq -r '.branch // empty' "$file")
  branch_mismatch=0
  # branch_slug() collapses '/' to '-', so e.g. feat/foo and feat-foo share a
  # ledger file. If the branch recorded in the file isn't the branch we're
  # actually on, the file was written by the other branch — don't trust its
  # verdicts, report as if nothing was ever recorded for this branch.
  [ "$stored_branch" = "$cur_branch" ] || branch_mismatch=1

  # Gate→pass-token→mode table: "gate:PASS_TOKEN:MODE" entries, audit-then-
  # acceptance-then-pre-mortem order preserved.
  #   required — near-universal; absence itself is worth flagging ("never ran"),
  #     and a clean verdict at HEAD joins the "proceed" summary.
  #   advisory — most branches never record one. The epic finale is the only
  #     intended writer of `pre-mortem`, on an epic's integration branch, but
  #     that write side is not yet wired into workflows/epic-driver.js — this
  #     read side is dormant on every branch until a follow-up adds it (see
  #     docs/studious/premortems/2026-07-09-premortem-hook-awareness-design.md
  #     for that story's own record of the gap). The CLEAR/REALIZED vocabulary read
  #     here has its canonical home in reference/gate-vocabulary.md, distinct
  #     from the per-item REALIZED / NOT REALIZED / CAN'T VERIFY vocabulary
  #     agents/premortem-auditor.md emits. Absence means "not applicable
  #     here," not "should have run and didn't," so an advisory gate stays
  #     silent both when absent AND when clean at HEAD; it only speaks up to
  #     flag a stale or non-passing verdict.
  local gates=("audit:PASS:required" "acceptance:SHIP:required" "pre-mortem:CLEAR:advisory")
  local msgs=()
  local pass_parts=()
  local gate pass mode v s entry rest
  for entry in "${gates[@]}"; do
    gate="${entry%%:*}"
    rest="${entry#*:}"
    pass="${rest%%:*}"
    mode="${rest##*:}"
    if [ "$branch_mismatch" -eq 1 ]; then
      v=""
      s=""
    else
      # Use --arg + bracket index: dot-syntax (.gates.$gate) parses '-' as
      # subtraction and compile-errors on hyphenated gate names (e.g. the
      # planned should-we-build / design-review gates).
      v=$(jq -r --arg g "$gate" '.gates[$g].verdict // empty' "$file")
      s=$(jq -r --arg g "$gate" '.gates[$g].sha // empty' "$file")
    fi
    if [ -z "$v" ]; then
      [ "$mode" = "required" ] && msgs+=("$gate never ran on this branch")
      continue
    fi
    if [ "$s" != "$head" ]; then
      n=$(git rev-list --count "$s..$head" 2>/dev/null || git rev-list --count "$s..HEAD" 2>/dev/null)
      if [ -n "$n" ] && [ "$n" -gt 0 ] 2>/dev/null; then
        if [ "$n" -eq 1 ]; then unit=commit; else unit=commits; fi
        msgs+=("$gate ran $n $unit ago — re-run before merging")
      else
        msgs+=("$gate ran at $s but HEAD is $head — re-run before merging")
      fi
      continue
    fi
    if [ "$v" != "$pass" ]; then
      msgs+=("$gate returned $v")
      continue
    fi
    # Clean at HEAD: required gates join the proceed summary; an advisory
    # gate's clean state (CLEAR) is silent, same as its absence.
    [ "$mode" = "required" ] && pass_parts+=("$gate ($pass)")
  done

  if [ "${#msgs[@]}" -eq 0 ]; then
    local pass_str=""
    if [ "${#pass_parts[@]}" -gt 0 ]; then
      pass_str="${pass_parts[0]}"
      local i
      for (( i=1; i<${#pass_parts[@]}; i++ )); do
        pass_str="$pass_str and ${pass_parts[$i]}"
      done
    fi
    printf '%s ran on this branch at HEAD — proceed.' "$pass_str"
  else
    local joined; joined=$(printf '%s; ' "${msgs[@]}"); joined=${joined%; }
    printf 'Studious gate check — %s. Proceed anyway?' "$joined"
  fi
}

cmd_gate_get() {
  local branch=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --branch) branch="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  local slug; slug=$(branch_slug "$branch")
  local file; file="$(ledger_dir)/$slug.json"
  [ -f "$file" ] || return 0
  cat "$file"
}

# Gate episodes (#289): one bounded run of a gate on a branch — opened at a sha,
# advanced by at most one fix round, closed by a verdict. The record lives in the
# same per-branch gates file as `.gates`, under `.episodes[<gate>]`:
#
#   {sha, round, openedAt}              after episode-open (round is always 1)
#   {sha, round, openedAt, verdict, verdictAt}  after episode-verdict
#
# `sha` is the code state the episode's latest judgment saw: HEAD at open, then
# refreshed by episode-verdict so the episode record and the dual-written legacy
# `.gates` entry always carry the same verdict and sha. The round cap below
# bounds ONE episode, never the branch — a fresh `episode-open` fully replaces
# the gate's episode at round 1 (upsert posture, exactly like `record`), which is
# what makes the cap a stop-and-rethink point rather than a permanent lockout.
EPISODE_ROUND_CAP=2

episode_round_get() { # gate → prints the current branch's recorded round for that gate's episode, nothing if no episode is open
  local file; file="$(ledger_dir)/$(branch_slug).json"
  [ -f "$file" ] || return 0
  jq -r --arg g "$1" '.episodes[$g].round // empty' "$file" 2>/dev/null
}

cmd_episode_open() {
  local gate=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --gate) gate="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$gate" ]; then
    echo "gate-ledger: --gate required" >&2
    return 2
  fi
  if ! have jq || ! have git; then
    echo "gate-ledger: episode-open skipped (jq and git required)" >&2
    return 0
  fi

  ensure_gitignore
  local file; file=$(gates_file_init)
  # Full replace of the gate's episode: reopening starts a fresh episode at
  # round 1 (see the schema comment above). Only `.episodes` is touched — a
  # prior episode's dual-written `.gates` entry survives, exactly as if a
  # plain `record` had written it.
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  json_update "$file" \
    '.schemaVersion = (.schemaVersion // 1)
     | .branch = $b
     | .episodes[$g] = {sha: $s, round: 1, openedAt: $t}' \
    --arg b "$(branch_name)" --arg g "$gate" --arg s "$(head_sha)" --arg t "$(now_iso)"
}

cmd_episode_round() {
  local gate=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --gate) gate="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$gate" ]; then
    echo "gate-ledger: --gate required" >&2
    return 2
  fi
  if ! have jq || ! have git; then
    echo "gate-ledger: episode-round skipped (jq and git required)" >&2
    return 0
  fi

  local round; round=$(episode_round_get "$gate")
  if [ -z "$round" ]; then
    echo "gate-ledger: no open episode for gate '$gate' on this branch (run episode-open first)" >&2
    return 2
  fi
  case "$round" in
    *[!0-9]*) echo "gate-ledger: episode-round: corrupted round '$round' for gate '$gate'" >&2; return 1 ;;
  esac
  # The cap is enforced HERE, in code, never left to a prompt's own counting
  # ("code owns bookkeeping"): round 1 is the gate's first run, round 2 its one
  # fix-and-re-check, and a third round is refused — exit 1 (a state refusal,
  # distinct from the arg-validation 2s above) so a driver can branch on it.
  if [ "$round" -ge "$EPISODE_ROUND_CAP" ]; then
    echo "gate-ledger: episode-round refused for gate '$gate' — round $round is already recorded and" \
         "the ${EPISODE_ROUND_CAP}-round cap allows no third round; record a verdict, or episode-open a fresh episode" >&2
    return 1
  fi
  local file; file="$(ledger_dir)/$(branch_slug).json"
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  json_update "$file" '.episodes[$g].round = (.episodes[$g].round + 1)' --arg g "$gate"
}

cmd_episode_verdict() {
  local gate="" verdict=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --gate)    gate="$2"; shift 2 ;;
      --verdict) verdict="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$gate" ] || [ -z "$verdict" ]; then
    echo "gate-ledger: --gate and --verdict required" >&2
    return 2
  fi
  if ! have jq || ! have git; then
    echo "gate-ledger: episode-verdict skipped (jq and git required)" >&2
    return 0
  fi

  local round; round=$(episode_round_get "$gate")
  if [ -z "$round" ]; then
    echo "gate-ledger: no open episode for gate '$gate' on this branch (run episode-open first)" >&2
    return 2
  fi
  local file rc; file="$(ledger_dir)/$(branch_slug).json"
  # Merge, not replace: the episode keeps its round/openedAt and gains the
  # verdict; `sha` is refreshed to HEAD — the code state this verdict judged —
  # so it always equals the sha the dual-write below stamps.
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  json_update "$file" \
    '.episodes[$g] = (.episodes[$g] + {verdict: $v, sha: $s, verdictAt: $t})' \
    --arg g "$gate" --arg v "$verdict" --arg s "$(head_sha)" --arg t "$(now_iso)"
  rc=$?
  [ "$rc" -eq 0 ] || return "$rc"
  # Dual-write the legacy per-gate record through cmd_record itself — not a
  # reimplementation of its jq — so `status`/`gate-get` readers (the PR-time
  # hook, the epic driver, board-ui) see a record indistinguishable from one a
  # gate command wrote directly, events append included. Same process, same
  # HEAD: the sha cmd_record stamps is the sha written just above.
  cmd_record --gate "$gate" --verdict "$verdict"
}

work_file_init() { # slug → ensures the work file exists, echoes its path
  local slug="$1"
  local dir; dir=$(work_dir)
  mkdir -p "$dir"
  local file; file="$dir/$slug.json"
  [ -f "$file" ] || printf '{"schemaVersion":1,"slug":"%s","history":[]}' "$slug" > "$file"
  printf '%s' "$file"
}

cmd_work_set() {
  local slug="" title="" src="" branch="" doc="" phase="" declared="" declared_given=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug)           slug="$2"; shift 2 ;;
      --title)          title="$2"; shift 2 ;;
      --source)         src="$2"; shift 2 ;;
      --branch)         branch="$2"; shift 2 ;;
      --design-doc)     doc="$2"; shift 2 ;;
      --declared-files) declared="$2"; declared_given=1; shift 2 ;;
      --phase)          phase="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$slug" ]; then
    echo "gate-ledger: --slug required" >&2
    return 2
  fi
  if ! have jq || ! have git; then
    echo "gate-ledger: work-set skipped (jq and git required)" >&2
    return 0
  fi

  local raw_slug="$slug"
  slug=$(slugify "$slug")
  if [ -z "$slug" ]; then
    echo "gate-ledger: --slug reduced to nothing after slugify" >&2
    return 2
  fi

  ensure_gitignore
  local file; file=$(work_file_init "$slug")
  local rc
  # Scope-delta measurement (#244): --declared-files is the design worker's own
  # forecast of the exact files this story expects to touch — a distinct
  # work-file field (declaredFiles), never parsed from the design doc itself
  # (reference/design-doc-contract.md puts file layout outside that doc's
  # scope) and never a directory prefix (exact paths only, per the design's
  # own "Alternatives considered"). An explicitly empty --declared-files
  # ("") is a real declaration of zero files, not "not provided" — csv_trim
  # maps it to []; distinguishing that from "never declared" (the field
  # simply absent) is what lets a later reader tell "declared nothing" apart
  # from "no declaration exists," so unlike every other optional field on
  # this verb, it is written whenever the flag is present at all (tracked by
  # `declared_given`, set in the arg-parsing loop above), not only when
  # non-empty. `| unique` matches the report side's own treatment of
  # `outsideFiles` (commands/work-through.md's jq) — a repeated path in the
  # declaration must not inflate `declared \(N)` against a set that "one file
  # counts once" already keeps disjoint on the outside-files side.
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  json_update "$file" \
    'def csv_trim: split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""));
     .schemaVersion = (.schemaVersion // 1)
     | .createdAt = (.createdAt // $t)
     | .updatedAt = $t
     | (if $title    != "" then .title        = $title            else . end)
     | (if $src      != "" then .source       = $src              else . end)
     | (if $branch   != "" then .branch       = $branch           else . end)
     | (if $doc      != "" then .designDoc    = $doc              else . end)
     | (if $declGiven == "1" then .declaredFiles = ($decl | csv_trim | unique) else . end)
     | (if $phase    != "" then .phase        = $phase            else . end)' \
    --arg title "$title" --arg src "$src" --arg branch "$branch" \
    --arg doc "$doc" --arg decl "$declared" --arg declGiven "$declared_given" \
    --arg phase "$phase" --arg t "$(now_iso)"
  rc=$?

  if [ "$rc" -eq 0 ] && [ -n "$phase" ]; then
    local ctx epicSlug storySlug
    ctx=$(epic_context_from_slug "$raw_slug")
    if [ -n "$ctx" ]; then
      IFS=$'\t' read -r epicSlug storySlug <<< "$ctx"
      # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
      append_event "$epicSlug" "$storySlug" "phase" '{phase: $phase}' --arg phase "$phase"
    fi
  fi
  return "$rc"
}

validate_work_log_args() { # step outcome sdPhase sdFilesGiven sdUnmeasured amendFile amendReason sdReason ->
  # cmd_work_log's own seven argument-combination rules, extracted so the verb's
  # body reads as one parse loop, one validation pass, one jq write — not seven
  # sequential branches ahead of the write they gate. Pure: reads only its own
  # positional args, echoes at most one error to stderr, and returns non-zero
  # on the FIRST rule a caller's flag combination violates. `slug` is checked
  # by the caller before this runs (it gates work_file_init below, not the
  # flag-combination rules this function owns).
  local step="$1" outcome="$2" sd_phase="$3" sd_files_given="$4" sd_unmeasured="$5" \
        amend_file="$6" amend_reason="$7" sd_reason="$8"
  # --step/--outcome are paired (both or neither) — the flow-position history
  # entry they write is optional on this verb only because scope-delta
  # measurement (#244) needs a work-log call that records nothing but a
  # moment's outside-file count or a fixer's amendment, with no step of its
  # own to log (a fixer never had one — it only ever bumped a retry counter
  # via epic-story-set). At least one of a step/outcome pair, a scope-delta
  # write, or an amendment must be present; a call that would do nothing is
  # a caller error, not a silent no-op.
  if { [ -n "$step" ] && [ -z "$outcome" ]; } || { [ -z "$step" ] && [ -n "$outcome" ]; }; then
    echo "gate-ledger: --step and --outcome must be given together" >&2
    return 1
  fi
  if { [ -n "$amend_file" ] && [ -z "$amend_reason" ]; } || { [ -z "$amend_file" ] && [ -n "$amend_reason" ]; }; then
    echo "gate-ledger: --amend-file and --amend-reason must be given together" >&2
    return 1
  fi
  if [ "$sd_files_given" -eq 1 ] && [ "$sd_unmeasured" -eq 1 ]; then
    echo "gate-ledger: --scope-delta-files and --scope-delta-unmeasured are mutually exclusive" >&2
    return 1
  fi
  if { [ "$sd_files_given" -eq 1 ] || [ "$sd_unmeasured" -eq 1 ] || [ -n "$amend_file" ]; } && [ -z "$sd_phase" ]; then
    echo "gate-ledger: --scope-delta-phase required with --scope-delta-files, --scope-delta-unmeasured, or --amend-file" >&2
    return 1
  fi
  # Fix-and-retry finding 3 (#244): --scope-delta-reason names WHY a moment is
  # unmeasured — meaningless on anything else. Reject it standing alone or
  # paired with --scope-delta-files, the same "reject the impossible
  # combination" posture as the mutual-exclusion rule just above.
  if [ -n "$sd_reason" ] && [ "$sd_unmeasured" -ne 1 ]; then
    echo "gate-ledger: --scope-delta-reason requires --scope-delta-unmeasured" >&2
    return 1
  fi
  if [ -z "$step" ] && [ "$sd_files_given" -eq 0 ] && [ "$sd_unmeasured" -eq 0 ] && [ -z "$amend_file" ]; then
    echo "gate-ledger: nothing to record — give --step/--outcome, --scope-delta-phase (with --scope-delta-files or --scope-delta-unmeasured), or --amend-file/--amend-reason" >&2
    return 1
  fi
  return 0
}

cmd_work_log() {
  local slug="" step="" outcome="" phase="" \
        sd_phase="" sd_files="" sd_files_given=0 sd_unmeasured=0 sd_reason="" \
        amend_file="" amend_reason=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug)                  slug="$2"; shift 2 ;;
      --step)                  step="$2"; shift 2 ;;
      --outcome)                outcome="$2"; shift 2 ;;
      --phase)                 phase="$2"; shift 2 ;;
      --scope-delta-phase)     sd_phase="$2"; shift 2 ;;
      --scope-delta-files)     sd_files="$2"; sd_files_given=1; shift 2 ;;
      --scope-delta-unmeasured) sd_unmeasured=1; shift ;;
      --scope-delta-reason)    sd_reason="$2"; shift 2 ;;
      --amend-file)            amend_file="$2"; shift 2 ;;
      --amend-reason)          amend_reason="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$slug" ]; then
    echo "gate-ledger: --slug required" >&2
    return 2
  fi
  validate_work_log_args "$step" "$outcome" "$sd_phase" "$sd_files_given" "$sd_unmeasured" \
    "$amend_file" "$amend_reason" "$sd_reason" || return 2
  # Per-step outcome vocabulary. Only a step whose *reader* branches on the token is
  # constrained here; gate steps carry verdicts owned by reference/gate-vocabulary.md
  # and stay free-form, as do markers like run-boundary. `build` is constrained because
  # work-on.md's "Executor-reported build status" check branches on exactly these, and
  # three writers had drifted into two dialects with nothing to catch it (#213). This
  # vocabulary governs `--outcome` alone — scope-delta measurement (#244) rides its own
  # dedicated fields (`--scope-delta-*`/`--amend-*`) precisely so it never has to widen
  # (or smuggle a composite value through) this closed list.
  #   BUILT | PAUSED | ESCALATED  executor-reported terminal status (worker-contract.md)
  #   HANDED-OFF | SKIPPED        /work-on's own non-terminal flow markers
  if [ "$step" = "build" ]; then
    case "$outcome" in
      BUILT|PAUSED|ESCALATED|HANDED-OFF|SKIPPED) ;;
      *)
        echo "gate-ledger: --step build --outcome '$outcome' is not a recognized status;" \
             "use BUILT, PAUSED, ESCALATED, HANDED-OFF, or SKIPPED" \
             "(reference/worker-contract.md, Status reporting)" >&2
        return 2
        ;;
    esac
  fi
  # Fix-and-retry finding 3 (#244): --scope-delta-reason's own closed
  # vocabulary — mirrors the --step build --outcome check above, same
  # posture (reject a token outside the set, name the accepted values).
  # Optional: an omitted reason still writes a valid unmeasured entry (a
  # caller that predates this flag, or one that has nothing more specific to
  # say), so this only fires when a value was actually given.
  if [ -n "$sd_reason" ]; then
    case "$sd_reason" in
      dispatch-failed|no-declaration|unsafe-path) ;;
      *)
        echo "gate-ledger: --scope-delta-reason '$sd_reason' is not a recognized reason;" \
             "use dispatch-failed, no-declaration, or unsafe-path" >&2
        return 2
        ;;
    esac
  fi
  if ! have jq || ! have git; then
    echo "gate-ledger: work-log skipped (jq and git required)" >&2
    return 0
  fi

  local raw_slug="$slug"
  slug=$(slugify "$slug")
  if [ -z "$slug" ]; then
    echo "gate-ledger: --slug reduced to nothing after slugify" >&2
    return 2
  fi

  ensure_gitignore
  local file; file=$(work_file_init "$slug")
  local sha rc
  sha="$(head_sha)"
  # Scope-delta measurement (#244): `.scopeDelta` is an append-only log of
  # per-moment measurements (one entry per work-log call that carries
  # --scope-delta-phase with either --scope-delta-files or
  # --scope-delta-unmeasured) — never rewritten, never summed here (the
  # reader, commands/work-through.md, does that from the verbatim entries).
  # `.amendments` is a separate append-only list keyed by file: a one-line
  # justification attached to a file some moment already counted as
  # outside the declaration. Neither ever removes or edits a prior entry in
  # either array, and neither ever touches `.history` or `$outcome` — see
  # the closed-vocabulary comment above. `unmeasured: true` carries an empty
  # `outsideFiles` so every entry has the same shape; the boolean, not the
  # (possibly coincidentally empty) array, is what a reader must branch on —
  # "unmeasured" and "measured zero" are different facts. `reason` (fix-and-
  # retry finding 3, #244) is present only on an unmeasured entry whose
  # caller gave `--scope-delta-reason` — a measured entry never carries the
  # key at all, and an unmeasured entry from before this flag existed, or
  # from a caller that omitted it, has no key either; a reader must treat a
  # missing key the same as "unspecified," never as a parse failure.
  local sd_write=0
  if [ "$sd_files_given" -eq 1 ] || [ "$sd_unmeasured" -eq 1 ]; then
    sd_write=1
  fi
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  json_update "$file" \
    'def csv_trim: split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""));
     (if $step != "" then .history = ((.history // []) + [{step: $step, outcome: $outcome, sha: $s, at: $t}]) else . end)
     | .updatedAt = $t
     | (if $phase != "" then .phase = $phase else . end)
     | (if $sdWrite == "1" then
         .scopeDelta = ((.scopeDelta // []) + [
           ({phase: $sdPhase, unmeasured: ($sdUnmeasured == "1"),
             outsideFiles: (if $sdUnmeasured == "1" then [] else ($sdFiles | csv_trim) end),
             sha: $s, at: $t}
            + (if $sdUnmeasured == "1" and $sdReason != "" then {reason: $sdReason} else {} end))])
       else . end)
     | (if $amendFile != "" then
         .amendments = ((.amendments // []) + [{file: $amendFile, phase: $sdPhase, reason: $amendReason, at: $t}])
       else . end)' \
    --arg step "$step" --arg outcome "$outcome" --arg phase "$phase" \
    --arg sdPhase "$sd_phase" --arg sdFiles "$sd_files" \
    --arg sdWrite "$sd_write" --arg sdUnmeasured "$sd_unmeasured" --arg sdReason "$sd_reason" \
    --arg amendFile "$amend_file" --arg amendReason "$amend_reason" \
    --arg s "$sha" --arg t "$(now_iso)"
  rc=$?

  # Event trail: only a call that actually logged a step (`--step`/`--outcome`
  # given) writes a "step" event — a scope-delta-only or amendment-only call
  # (no step of its own) has nothing analogous to log here yet, matching this
  # append's existing contract (reference/events-format.md) of one event per
  # recorded step, never a spurious empty one.
  if [ "$rc" -eq 0 ] && [ -n "$step" ]; then
    local ctx epicSlug storySlug
    ctx=$(epic_context_from_slug "$raw_slug")
    if [ -n "$ctx" ]; then
      IFS=$'\t' read -r epicSlug storySlug <<< "$ctx"
      # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
      append_event "$epicSlug" "$storySlug" "step" \
        '{step: $step, outcome: $outcome} + (if $phase != "" then {phase: $phase} else {} end) + {sha: $sha}' \
        --arg step "$step" --arg outcome "$outcome" --arg phase "$phase" --arg sha "$sha"
    fi
  fi
  return "$rc"
}

cmd_work_get() {
  local slug=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug) slug="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$slug" ]; then
    echo "gate-ledger: --slug required" >&2
    return 2
  fi
  slug=$(slugify "$slug")
  local file; file="$(work_dir)/$slug.json"
  [ -f "$file" ] || return 0
  cat "$file"
}

epic_file_init() { # slug → ensures the epic file exists, echoes its path
  local slug="$1"
  local dir; dir=$(epic_dir)
  mkdir -p "$dir"
  local file; file="$dir/$slug.json"
  [ -f "$file" ] || printf '{"schemaVersion":1,"slug":"%s","status":"planning","stories":{}}' "$slug" > "$file"
  printf '%s' "$file"
}

cmd_epic_set() {
  local slug="" title="" src="" goal="" branch="" premortem="" concurrency="" status=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug)        slug="$2"; shift 2 ;;
      --title)       title="$2"; shift 2 ;;
      --source)      src="$2"; shift 2 ;;
      --goal)        goal="$2"; shift 2 ;;
      --branch)      branch="$2"; shift 2 ;;
      --premortem)   premortem="$2"; shift 2 ;;
      --concurrency) concurrency="$2"; shift 2 ;;
      --status)      status="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$slug" ]; then
    echo "gate-ledger: --slug required" >&2
    return 2
  fi
  case "$concurrency" in
    '') ;; # not provided: fine, left unset in the jq update
    *[!0-9]*|0) echo "gate-ledger: --concurrency must be a positive integer" >&2; return 2 ;;
  esac
  if ! have jq || ! have git; then
    echo "gate-ledger: epic-set skipped (jq and git required)" >&2
    return 0
  fi

  slug=$(slugify "$slug")
  if [ -z "$slug" ]; then
    echo "gate-ledger: --slug reduced to nothing after slugify" >&2
    return 2
  fi

  ensure_gitignore
  local file; file=$(epic_file_init "$slug")
  local rc
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  json_update "$file" \
    '.schemaVersion = (.schemaVersion // 1)
     | .createdAt = (.createdAt // $t)
     | .updatedAt = $t
     | (if $title  != "" then .title       = $title  else . end)
     | (if $src    != "" then .source      = $src    else . end)
     | (if $goal   != "" then .goal        = $goal   else . end)
     | (if $branch != "" then .branch      = $branch else . end)
     | (if $pm     != "" then .premortem   = $pm     else . end)
     | (if $conc   != "" then .concurrency = ($conc | tonumber) else . end)
     | (if $status != "" then .status      = $status else . end)' \
    --arg title "$title" --arg src "$src" --arg goal "$goal" --arg branch "$branch" \
    --arg pm "$premortem" --arg conc "$concurrency" --arg status "$status" --arg t "$(now_iso)"
  rc=$?

  if [ "$rc" -eq 0 ] && [ -n "$status" ]; then
    # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
    append_event "$slug" "" "epic-status" '{status: $status}' --arg status "$status"
  fi
  return "$rc"
}

cmd_epic_get() {
  local slug=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug) slug="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$slug" ]; then
    echo "gate-ledger: --slug required" >&2
    return 2
  fi
  slug=$(slugify "$slug")
  local file; file="$(epic_dir)/$slug.json"
  [ -f "$file" ] || return 0
  cat "$file"
}

cmd_epic_story_set() {
  local epic="" slug="" title="" src="" criteria="" decisions="" carried="" deps="" gates_csv="" status="" reason="" worktree="" bump="" reset=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --epic)        epic="$2"; shift 2 ;;
      --slug)        slug="$2"; shift 2 ;;
      --title)       title="$2"; shift 2 ;;
      --source)      src="$2"; shift 2 ;;
      --criteria)    criteria="$2"; shift 2 ;;
      --decisions)   decisions="$2"; shift 2 ;;
      --carried-findings) carried="$2"; shift 2 ;;
      --deps)        deps="$2"; shift 2 ;;
      --gates)       gates_csv="$2"; shift 2 ;;
      --status)      status="$2"; shift 2 ;;
      --reason)      reason="$2"; shift 2 ;;
      --worktree)    worktree="$2"; shift 2 ;;
      --bump-retry)  bump="$2"; shift 2 ;;
      --reset-retry) reset="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$epic" ] || [ -z "$slug" ]; then
    echo "gate-ledger: --epic and --slug required" >&2
    return 2
  fi
  if ! have jq || ! have git; then
    echo "gate-ledger: epic-story-set skipped (jq and git required)" >&2
    return 0
  fi

  epic=$(slugify "$epic")
  slug=$(slugify "$slug")
  if [ -z "$epic" ] || [ -z "$slug" ]; then
    echo "gate-ledger: --epic or --slug reduced to nothing after slugify" >&2
    return 2
  fi

  local file; file="$(epic_dir)/$epic.json"
  if [ ! -f "$file" ]; then
    echo "gate-ledger: no epic file for '$epic' (run epic-set first)" >&2
    return 2
  fi

  local rc
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  json_update "$file" \
    'def csv_trim: split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""));
     .updatedAt = $t
     | .stories[$s] = ((.stories[$s] // {status: "pending", deps: [], retries: {}})
       | (if $title    != "" then .title    = $title    else . end)
       | (if $src      != "" then .source   = $src      else . end)
       | (if $criteria != "" then .criteria = $criteria else . end)
       | (if $decisions != "" then .decisions = $decisions else . end)
       | (if $carried  != "" then .carriedFindings = $carried else . end)
       | (if $deps     != "" then .deps     = ($deps  | csv_trim) else . end)
       | (if $gates    != "" then .gates    = ($gates | csv_trim) else . end)
       | (if $status   != "" then .status   = $status   else . end)
       | (if $reason   != "" then .reason   = $reason   else . end)
       | (if $wt       != "" then .worktree = $wt       else . end)
       | (if $bump     != "" then .retries[$bump]  = ((.retries[$bump]  // 0) + 1) else . end)
       | (if $reset    != "" then .retries[$reset] = 0 else . end))' \
    --arg s "$slug" --arg title "$title" --arg src "$src" --arg criteria "$criteria" \
    --arg decisions "$decisions" --arg carried "$carried" \
    --arg deps "$deps" --arg gates "$gates_csv" --arg status "$status" --arg reason "$reason" \
    --arg wt "$worktree" --arg bump "$bump" --arg reset "$reset" --arg t "$(now_iso)"
  rc=$?

  if [ "$rc" -eq 0 ] && { [ -n "$status" ] || [ -n "$reason" ] || [ -n "$bump" ] || [ -n "$reset" ]; }; then
    # Both retry counters are read back post-write (the events line always
    # reflects the file's new state, not a value computed independently of it).
    local bump_retries="0" reset_retries="0"
    [ -n "$bump" ]  && bump_retries=$(jq -r --arg s "$slug" --arg g "$bump" '.stories[$s].retries[$g] // 0' "$file")
    [ -n "$reset" ] && reset_retries=$(jq -r --arg s "$slug" --arg g "$reset" '.stories[$s].retries[$g] // 0' "$file")
    # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
    append_event "$epic" "$slug" "story" \
      '(if $status != "" then {status: $status} else {} end)
       + (if $reason != "" then {reason: $reason} else {} end)
       + (if $bump   != "" then {bumpRetryGate: $bump, retries: ($bumpRetries | tonumber)} else {} end)
       + (if $reset  != "" then {resetRetryGate: $reset, retries: ($resetRetries | tonumber)} else {} end)' \
      --arg status "$status" --arg reason "$reason" --arg bump "$bump" --arg reset "$reset" \
      --arg bumpRetries "$bump_retries" --arg resetRetries "$reset_retries"
  fi
  return "$rc"
}

cmd_worktree_path() { # --slug E [--story S | --json] -> one path, or the epic's whole layout as JSON
  # The read side of worktree_path() above — what makes it the layout's owner
  # for callers that aren't this script.
  #
  #   --slug E             the epic's `__epic` integration checkout
  #   --slug E --story S   story S's checkout
  #   --slug E --json      {"epic": "…", "stories": {"<story>": "…", …}} over
  #                        every story recorded in the epic file
  #
  # The --json form has exactly one caller, and it needs the whole map rather
  # than one path per call for a structural reason: workflows/epic-driver.js
  # runs on the Workflow substrate with no filesystem or exec access, so it can
  # never invoke this verb itself. commands/work-through.md calls it once and
  # hands the result to the driver as args.worktrees. The layout crosses that
  # boundary as data — the only way the driver can reference the owner instead
  # of re-deriving the layout a fourth time (#166).
  #
  # The two plain forms compose a path without consulting the epic file, so
  # they answer for a worktree that doesn't exist yet — work-through.md's step 5
  # runs `git worktree add` at a path this verb resolved before there was an
  # epic file to read.
  local slug="" story="" as_json=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug)  slug="$2"; shift 2 ;;
      --story) story="$2"; shift 2 ;;
      --json)  as_json=1; shift ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$slug" ]; then
    echo "gate-ledger: --slug required" >&2
    return 2
  fi
  if [ -n "$as_json" ] && [ -n "$story" ]; then
    echo "gate-ledger: worktree-path: --story and --json are mutually exclusive" >&2
    return 2
  fi

  slug=$(slugify "$slug")
  if [ -z "$slug" ]; then
    echo "gate-ledger: --slug reduced to nothing after slugify" >&2
    return 2
  fi

  # Same root-anchoring every other store uses: a story worker running in a
  # linked worktree still resolves paths against the MAIN working tree, so it
  # names its siblings' checkouts the way the driver does.
  local root; root=$(repo_root) || root="$PWD"

  if [ -z "$as_json" ]; then
    if [ -n "$story" ]; then
      story=$(slugify "$story")
      if [ -z "$story" ]; then
        echo "gate-ledger: --story reduced to nothing after slugify" >&2
        return 2
      fi
      worktree_path "$root" "$slug" "$story"
    else
      worktree_path "$root" "$slug"
    fi
    printf '\n'
    return 0
  fi

  if ! have jq; then return 0; fi
  local epic_json; epic_json=$(cmd_epic_get --slug "$slug")
  [ -n "$epic_json" ] || return 0  # no epic recorded — mirror epic-get's own "nothing" behavior
  if ! printf '%s' "$epic_json" | jq empty 2>/dev/null; then
    echo "gate-ledger: worktree-path: corrupted epic file for '$slug'" >&2
    return 1
  fi

  local stories_json="{}" s
  while IFS= read -r s; do
    [ -n "$s" ] || continue
    # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
    stories_json=$(jq -n --argjson stories "$stories_json" --arg s "$s" \
      --arg path "$(worktree_path "$root" "$slug" "$s")" '$stories + {($s): $path}')
  done <<< "$(printf '%s' "$epic_json" | jq -r '.stories | keys[]')"

  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  jq -n --arg epic "$(worktree_path "$root" "$slug")" --argjson stories "$stories_json" \
    '{epic: $epic, stories: $stories}'
}

reconcile_story() { # <epic-slug> <story-slug> <epic-json> <repo-root> -> that story's object for .stories[<story>]
  # One story's reconciled record: its work file, its gate verdicts at the story
  # branch's HEAD, and the two mechanical checks epic-reconcile adds on top
  # (designDocExists, landedButUnmerged). Extracted from cmd_epic_reconcile's
  # loop body (#165) so the per-story shape has one place to grow a field; the
  # caller owns iteration and accumulation, this owns exactly one story.
  #
  # Every input arrives as an argument — nothing is read out of the caller's
  # scope — so this reads as a function of its inputs rather than of whatever
  # `local` the loop happens to be standing in.
  #
  # Returns 1, printing its diagnostic to stderr and nothing to stdout, when a
  # stored file this story depends on is corrupted. The caller MUST propagate
  # that: swallowing it emits a partial payload under a zero exit code.
  local slug="$1" s="$2" epic_json="$3" root="$4"
  local work_json gate_json story_status design_doc story_sha wt_base design_exists landed_unmerged

  work_json=$(cmd_work_get --slug "$slug--$s")
  if [ -n "$work_json" ] && ! printf '%s' "$work_json" | jq empty 2>/dev/null; then
    echo "gate-ledger: epic-reconcile: corrupted work file for story '$s' (epic '$slug')" >&2
    return 1
  fi

  gate_json=$(cmd_gate_get --branch "epic/$slug--$s")
  if [ -n "$gate_json" ] && ! printf '%s' "$gate_json" | jq empty 2>/dev/null; then
    echo "gate-ledger: epic-reconcile: corrupted gate ledger for story '$s' (epic '$slug')" >&2
    return 1
  fi

  story_status=$(printf '%s' "$epic_json" | jq -r --arg s "$s" '.stories[$s].status // ""')
  story_sha=$(git rev-parse --short "refs/heads/epic/$slug--$s" 2>/dev/null || echo "")

  # designDocExists: null when no designDoc is recorded, or when the
  # worktree it would live in is already gone (degrade, don't crash or
  # false-flag — see the design doc's open question on this).
  design_doc=""
  [ -n "$work_json" ] && design_doc=$(printf '%s' "$work_json" | jq -r '.designDoc // ""')
  if [ -z "$design_doc" ]; then
    design_exists="null"
  else
    # A landed story's own worktree is removed at merge, so its doc is looked up
    # in the integration worktree instead — both paths from worktree_path(), the
    # one owner of this layout.
    if [ "$story_status" = "landed" ]; then
      wt_base=$(worktree_path "$root" "$slug")
    else
      wt_base=$(worktree_path "$root" "$slug" "$s")
    fi
    if [ ! -d "$wt_base" ]; then
      design_exists="null"
    elif [ -f "$wt_base/$design_doc" ]; then
      design_exists="true"
    else
      design_exists="false"
    fi
  fi

  # landedButUnmerged: only meaningful for a story recorded `landed`.
  # merge-base --is-ancestor collapses "never merged", "branch doesn't
  # exist", and "not an ancestor yet" to the same non-zero exit — exactly
  # "not verified merged," which is the fail-closed answer this wants.
  landed_unmerged="false"
  if [ "$story_status" = "landed" ] && ! git merge-base --is-ancestor \
      "refs/heads/epic/$slug--$s" "refs/heads/epic/$slug" 2>/dev/null; then
    landed_unmerged="true"
  fi

  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  jq -n \
    --argjson work "${work_json:-null}" --argjson gate "${gate_json:-null}" \
    --arg sha "$story_sha" --argjson designExists "$design_exists" --argjson landedUnmerged "$landed_unmerged" \
    '{work: $work, gate: $gate, storyBranchHeadSha: $sha,
      designDocExists: $designExists, landedButUnmerged: $landedUnmerged}'
}

cmd_epic_reconcile() { # --slug E -> one JSON payload replacing work-through's ~15-20 sequential reads
  # Composes cmd_epic_get / cmd_work_get / cmd_gate_get as in-process bash calls
  # (reuse, not re-derivation of their path/slug logic — see the design doc),
  # then adds two mechanical, non-judgment checks per story: whether its
  # recorded designDoc exists on disk, and whether a story recorded `landed`
  # is actually an ancestor of the epic branch. This verb only aggregates and
  # computes; it never corrects a mismatch or decides a story's next phase —
  # that judgment stays in commands/work-through.md's prose.
  local slug=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug) slug="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$slug" ]; then
    echo "gate-ledger: --slug required" >&2
    return 2
  fi
  if ! have jq || ! have git; then
    echo "gate-ledger: epic-reconcile skipped (jq and git required)" >&2
    return 0
  fi

  slug=$(slugify "$slug")
  if [ -z "$slug" ]; then
    echo "gate-ledger: --slug reduced to nothing after slugify" >&2
    return 2
  fi

  local epic_json; epic_json=$(cmd_epic_get --slug "$slug")
  [ -n "$epic_json" ] || return 0  # no epic recorded — mirror epic-get's own "nothing" behavior
  if ! printf '%s' "$epic_json" | jq empty 2>/dev/null; then
    echo "gate-ledger: epic-reconcile: corrupted epic file for '$slug'" >&2
    return 1
  fi

  local root; root=$(repo_root) || root="$PWD"
  local story_slugs; story_slugs=$(printf '%s' "$epic_json" | jq -r '.stories | keys[]')

  local stories_json="{}"
  local s story_obj
  while IFS= read -r s; do
    [ -n "$s" ] || continue
    # Assignment first, status test second: `local x=$(…)` would mask the
    # helper's exit code, turning a corrupted stored file into a silent partial
    # payload. The helper prints its own diagnostic to stderr before failing.
    story_obj=$(reconcile_story "$slug" "$s" "$epic_json" "$root") || return 1
    # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
    stories_json=$(jq -n \
      --argjson stories "$stories_json" --arg s "$s" --argjson story "$story_obj" \
      '$stories + {($s): $story}')
  done <<< "$story_slugs"

  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  jq -n --argjson epic "$epic_json" --argjson stories "$stories_json" '{epic: $epic, stories: $stories}'
}

cmd_epic_list() {
  if ! have jq; then return 0; fi
  local dir; dir=$(epic_dir)
  local f
  for f in "$dir"/*.json; do
    [ -e "$f" ] || continue
    jq -r '[(.slug // "?"), (.status // "?"),
            (([.stories[] | select(.status == "landed")] | length | tostring) + "/" + (.stories | length | tostring)),
            (.branch // "-"), (.title // "-")] | @tsv' "$f" 2>/dev/null
  done
}

cmd_work_list() {
  if ! have jq; then return 0; fi
  local dir; dir=$(work_dir)
  local f
  for f in "$dir"/*.json; do
    [ -e "$f" ] || continue
    jq -r '[(.slug // "?"), (.phase // "?"), (.branch // "-"), (.title // "-")] | @tsv' "$f" 2>/dev/null
  done
}

# Scope-delta measurement (#244) acceptance fix-and-retry: how long cmd_gc's
# measured-scope-delta guard (below) keeps a work file before collecting it
# regardless. Bounded, not permanent — the guard's first cut (`kept ... unless
# --force`) had no terminating condition, so it never released a file to the
# default (no-`--force`) path at all, silently re-disabling #237's fix on the
# exact epic-driven files it was written for. Three mechanisms were on the
# table: read-marking, bounded retention, per-slug opt-out. Read-marking is
# rejected because `work-get` is called constantly by the driver's own
# in-flow fact-checks (workflows/epic-driver.js) — marking "read" there would
# defeat the guard before a human ever saw the cohort, the same failure this
# guard exists to prevent, just relocated to a different call site. A
# per-slug opt-out is rejected because it is `--force` at file granularity —
# still a new action a human must remember to take, per file, rather than the
# guard ever releasing on its own. Bounded retention needs neither: the same
# plain `gc` a user already runs collects on its own once the window lapses,
# so a batch run stops being a permanent trap without adding a second way to
# lose data early. Not a flag — a configurable threshold is exactly the
# round-one-deferred "no threshold" surface this story's epic-planning
# decisions ruled out; the constant below is the whole knob for now.
SCOPE_DELTA_RETENTION_DAYS=14

scope_delta_retention_lapsed() { # file -> true (exit 0) once its last write is older than the keep window; false (exit 1) otherwise, and fail toward keeping (false) on any read failure or missing timestamp
  local file="$1" updated
  updated=$(jq -r '.updatedAt // .createdAt // empty' "$file" 2>/dev/null)
  [ -n "$updated" ] || return 1
  jq -n -e --arg u "$updated" --argjson days "$SCOPE_DELTA_RETENTION_DAYS" \
    '(try (now - ($u | fromdateiso8601)) catch null) as $age
     | $age != null and $age > ($days * 86400)' >/dev/null 2>&1
}

cmd_gc() {
  # Scope-delta measurement (#244), pre-mortem register item 7 (REALIZED): a
  # work file is the only copy of `declaredFiles`/`scopeDelta`/`amendments` —
  # collecting it discards that story's measurement cohort for good. `--force`
  # opts back into the old unconditional-collect behavior; without it, a work
  # file that would otherwise be collected but still carries at least one
  # *measured* `.scopeDelta` moment (an entry with `unmeasured: true` carries
  # no file data by construction — see work-log above — so an all-unmeasured cohort has
  # nothing this guard exists to save; narrowing on measured entries, rather
  # than widening to `declaredFiles != null`, keeps a fallback-driven epic's
  # own --scope-delta-unmeasured-only moments from pinning every work file it
  # touches) is kept instead, named in the output, so a batch `gc` run can't
  # silently erase a cohort the same run it's needed for (success metric 1
  # wants 5-10 stories' worth, the same order of magnitude as the doctor's own
  # "more than 10 work files" gc recommendation). The keep itself is bounded
  # by SCOPE_DELTA_RETENTION_DAYS above — see that constant's comment for why.
  local force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      *) echo "gate-ledger: gc: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if ! have jq || ! have git; then return 0; fi
  local dir; dir=$(ledger_dir)
  local f branch
  for f in "$dir"/*.json; do
    [ -e "$f" ] || continue
    branch=$(jq -r '.branch // empty' "$f" 2>/dev/null)
    [ -n "$branch" ] || continue
    if ! git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null 2>&1; then
      rm -f "$f"
      printf 'removed stale ledger: %s (branch %s no longer exists)\n' "$(basename "$f")" "$branch"
    fi
  done

  # Work files: two independent collection rules, either one sufficient.
  #
  #   1. The branch is gone. The flow it tracked cannot be resumed.
  #   2. The phase is terminal (`done`/`stopped`). The file is flow *position*,
  #      and a finished flow has none; the durable record is the commit history,
  #      the PR, and the pre-mortem register.
  #
  # Rule 2 exists because rule 1 alone could not fire on the epic path (#237):
  # a landed story's branch is deliberately kept, so its work file was pinned
  # forever at phase `merge` and `/work-on` counted it as an active feature. Once
  # the driver writes a terminal phase, this is what actually collects it.
  #
  # A work file with no branch yet (decide/design happen before one exists) is
  # kept unless its phase is terminal.
  # Scope-delta measurement (#244) acceptance fix-and-retry, finding 2: the
  # measured-scope-delta guard below applies to rule 2 (terminal phase) ONLY —
  # never to rule 1 (branch gone), a deliberate asymmetry, not an oversight.
  # A story a human parked and then abandoned (deleted its branch, per
  # `commands/work-through.md`'s own parked-story instructions) never reached
  # acceptance, so its cohort is incomplete by construction and can never feed
  # the success-metric read the guard exists to protect (design doc's
  # "Success metrics" scopes that read to *landed* stories). Guarding rule 1
  # too was tried and reverted: `commands/work-on.md`'s resolve-the-feature
  # step selects by phase alone, never branch existence, so a rule-1 file the
  # guard kept pinned stayed counted Active in `commands/studious-doctor.md`'s
  # own >10 threshold — silently reintroducing the #237 symptom rule 2 exists
  # to avoid, to protect data nothing reads. Scoping the guard to rule 2 alone
  # keeps that command's Active count, and its "gc will collect it" promise
  # for a branch-gone file, both true as written.
  # This guard reads `.scopeDelta` — a field only `work-set --declared-files`
  # and `work-log --scope-delta-*` (below, and cmd_work_log above) ever
  # populate. A rollback that deletes just those two writers leaves this
  # guard, and the three scope-delta-conditional `printf` sites it feeds (one
  # `kept:` message, one past-retention-window `removed` message, and one
  # `--force discarded` message, all in rule 2's branch below), reading a
  # field nothing populates anymore: every file's `sd_len` computes to 0, the
  # guard never arms, and `gc` silently reverts to always collecting rule-2
  # files on first pass — the pre-#237 regression, with no visible symptom.
  # Roll back this whole block (`scope_delta_retention_lapsed` above included)
  # and the five `.scopeDelta`-describing spots in `commands/studious-
  # doctor.md` — its Retained bullet, both Classify thresholds that mention
  # retained files, the branch-gone bullet (finding 2's own asymmetry note),
  # and the Flow state output line — in the same change, or
  # the rollback is incomplete.
  local wdir; wdir=$(work_dir)
  local phase sd_len slug
  for f in "$wdir"/*.json; do
    [ -e "$f" ] || continue
    branch=$(jq -r '.branch // empty' "$f" 2>/dev/null)
    phase=$(jq -r '.phase // empty' "$f" 2>/dev/null)
    sd_len=$(jq -r '(.scopeDelta // []) | map(select(.unmeasured != true)) | length' "$f" 2>/dev/null)
    slug=$(basename "$f" .json)
    if [ "$phase" = "done" ] || [ "$phase" = "stopped" ]; then
      # Fix-and-retry finding 4 (#244 round 9): the read verb the retention
      # exists for, not just the two ways to destroy it.
      if [ "$force" -ne 1 ] && [ -n "$sd_len" ] && [ "$sd_len" != "0" ] && ! scope_delta_retention_lapsed "$f"; then
        printf 'kept: %s still holds %s measured scope-delta moment(s) — gate-ledger work-get --slug "%s" to read it, gc --force to collect now, or plain gc collects it %s days after its last write\n' \
          "$slug" "$sd_len" "$slug" "$SCOPE_DELTA_RETENTION_DAYS"
        continue
      fi
      rm -f "$f"
      if [ -n "$sd_len" ] && [ "$sd_len" != "0" ] && [ "$force" -eq 1 ]; then
        printf 'removed finished work file: %s (phase %s, --force discarded %s measured scope-delta moment(s))\n' \
          "$(basename "$f")" "$phase" "$sd_len"
      elif [ "$force" -ne 1 ] && [ -n "$sd_len" ] && [ "$sd_len" != "0" ]; then
        printf 'removed work file past its %s-day scope-delta keep window: %s (phase %s, %s measured scope-delta moment(s) recorded)\n' \
          "$SCOPE_DELTA_RETENTION_DAYS" "$(basename "$f")" "$phase" "$sd_len"
      else
        printf 'removed finished work file: %s (phase %s)\n' "$(basename "$f")" "$phase"
      fi
    elif [ -n "$branch" ] && ! git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null 2>&1; then
      # No scope-delta guard here — see this function's own comment above for
      # why rule 1 (branch gone) stays unconditional while rule 2 (terminal
      # phase) above does not.
      rm -f "$f"
      printf 'removed stale work file: %s (branch %s no longer exists)\n' "$(basename "$f")" "$branch"
    fi
  done

  # Epic state: collect an epic the driver finished (`epic-set --status ready`,
  # its finale step) once its integration branch is gone — which is what merging
  # the epic PR and deleting the branch leaves behind. `ready` alone is not
  # enough: it means "ready for you to open the PR", so the branch is still live
  # and the epic is still the answer to "what is in flight". Both conditions
  # together mean the epic shipped.
  #
  # An epic still `running`, or one whose branch survives, is left alone — that
  # includes an epic parked on a story, which is exactly the state a user needs
  # to still be able to see.
  local edir; edir=$(epic_dir)
  local status eslug
  for f in "$edir"/*.json; do
    [ -e "$f" ] || continue
    status=$(jq -r '.status // empty' "$f" 2>/dev/null)
    branch=$(jq -r '.branch // empty' "$f" 2>/dev/null)
    eslug=$(jq -r '.slug // empty' "$f" 2>/dev/null)
    [ "$status" = "ready" ] || continue
    [ -n "$branch" ] || branch="epic/$eslug"
    if ! git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null 2>&1; then
      rm -f "$f" "${f%.json}.events.jsonl"
      printf 'removed shipped epic: %s (status ready, branch %s no longer exists)\n' "$(basename "$f")" "$branch"
    fi
  done
}

cmd_evidence_append() { # append-only: one jq -nc object per call, >> the branch's .jsonl
  local command="" exit_code="" output_digest="" origin="" agent_type=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --command)       command="$2"; shift 2 ;;
      --exit-code)     exit_code="$2"; shift 2 ;;
      --output-digest) output_digest="$2"; shift 2 ;;
      --origin)        origin="$2"; shift 2 ;;
      --agent-type)    agent_type="$2"; shift 2 ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  if [ -z "$command" ] || [ -z "$exit_code" ] || [ -z "$output_digest" ] || [ -z "$origin" ]; then
    echo "gate-ledger: --command, --exit-code, --output-digest, and --origin required" >&2
    return 2
  fi
  case "$exit_code" in
    ''|*[!0-9]*) echo "gate-ledger: --exit-code must be a non-negative integer" >&2; return 2 ;;
  esac
  case "$origin" in
    interactive|subagent) ;;
    *) echo "gate-ledger: --origin must be 'interactive' or 'subagent'" >&2; return 2 ;;
  esac
  if ! have jq || ! have git; then
    echo "gate-ledger: evidence-append skipped (jq and git required)" >&2
    return 0
  fi

  ensure_gitignore
  local dir; dir=$(evidence_dir)
  mkdir -p "$dir"
  local file; file="$dir/$(branch_slug).jsonl"

  # capturer is hardcoded, never a caller-supplied flag: only this verb may
  # write "hook" as the capturer, so a caller can't spoof a different one.
  # predicateType/predicate.configuration are fixed to the one in-toto
  # test-result shape this story maps every captured command onto (see
  # reference/evidence-format.md) — not exposed as flags in v0.
  # shellcheck disable=SC2016 # jq's own $var syntax, not shell expansion
  jq -nc \
    --arg capturedAt "$(now_iso)" --arg origin "$origin" --arg agentType "$agent_type" \
    --arg command "$command" --argjson exitCode "$exit_code" --arg outputDigest "$output_digest" \
    '{capturedAt: $capturedAt, capturer: "hook", origin: $origin}
     + (if $agentType != "" then {agentType: $agentType} else {} end)
     + {command: $command, exitCode: $exitCode, outputDigest: $outputDigest,
        predicateType: "https://in-toto.io/attestation/test-result/v0.1",
        predicate: {result: (if $exitCode == 0 then "PASSED" else "FAILED" end),
                    configuration: [{name: $command}]}}' >> "$file"
}

cmd_evidence_list() { # optional --branch B: print that branch's evidence .jsonl verbatim; optional --dedupe: collapse to one record per distinct command (most recent wins), nothing if absent
  local branch="" dedupe=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --branch) branch="$2"; shift 2 ;;
      --dedupe) dedupe=1; shift ;;
      *) echo "gate-ledger: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  # Same evidence_dir()/branch_slug() anchoring evidence-append already uses,
  # so a caller (e.g. /handback) never re-derives repo-root or slug logic
  # itself — one place this store's location lives, reused by both the
  # writer and this reader. Mirrors cmd_gate_get's shape: resolve one
  # branch's file, print it verbatim, nothing if it doesn't exist yet.
  local slug; slug=$(branch_slug "$branch")
  local file; file="$(evidence_dir)/$slug.jsonl"
  [ -f "$file" ] || return 0

  if [ -z "$dedupe" ]; then
    # Never requires jq: reading and emitting the raw file needs no JSON parsing.
    cat "$file"
    return 0
  fi

  # --dedupe: keep exactly one record per distinct `command` value — the one
  # appended last — printed in the survivors' original (chronological)
  # relative order. Index-based (to_entries/reduce over a command->last-index
  # map), deliberately not unique_by (which sorts by the grouping key and
  # would reorder output alphabetically by command) or whole-object equality
  # (a latent bug for two records byte-identical in every field, including
  # capturedAt — both would match and both would survive). See
  # docs/studious/premortems/2026-07-21-evidence-list-dedupe-design.md.
  # Fails closed: no jq, or a malformed line, means no stdout and a non-zero
  # exit — every existing caller already treats an evidence-list error
  # identically to empty output.
  if ! have jq; then
    echo "gate-ledger: evidence-list --dedupe requires jq" >&2
    return 1
  fi
  jq -c -s 'to_entries as $es
    | (reduce $es[] as $e ({}; .[$e.value.command] = $e.key)) as $last_idx
    | $es[] | select(.key == $last_idx[.value.command]) | .value' \
    "$file" \
    || { echo "gate-ledger: evidence-list --dedupe failed to parse $file" >&2; return 1; }
}

case "${1:-}" in
  record)          shift; cmd_record "$@" ;;
  status)          shift; cmd_status "$@" ;;
  gate-get)        shift; cmd_gate_get "$@" ;;
  episode-open)    shift; cmd_episode_open "$@" ;;
  episode-round)   shift; cmd_episode_round "$@" ;;
  episode-verdict) shift; cmd_episode_verdict "$@" ;;
  work-set)        shift; cmd_work_set "$@" ;;
  work-log)        shift; cmd_work_log "$@" ;;
  work-get)        shift; cmd_work_get "$@" ;;
  work-list)       shift; cmd_work_list "$@" ;;
  epic-set)        shift; cmd_epic_set "$@" ;;
  epic-get)        shift; cmd_epic_get "$@" ;;
  epic-story-set)  shift; cmd_epic_story_set "$@" ;;
  epic-reconcile)  shift; cmd_epic_reconcile "$@" ;;
  epic-list)       shift; cmd_epic_list "$@" ;;
  worktree-path)   shift; cmd_worktree_path "$@" ;;
  evidence-append) shift; cmd_evidence_append "$@" ;;
  evidence-list)   shift; cmd_evidence_list "$@" ;;
  gc)              shift; cmd_gc "$@" ;;
  *) echo "usage: gate-ledger {record --gate G --verdict V [--blocking-lanes L1,L2] | status | gate-get [--branch B] | episode-open --gate G | episode-round --gate G | episode-verdict --gate G --verdict V | work-set --slug S [--title T] [--source SRC] [--branch B] [--design-doc P] [--declared-files F1,F2] [--phase PH] | work-log --slug S ([--step ST --outcome O] | --scope-delta-phase PH2 (--scope-delta-files F1,F2 | --scope-delta-unmeasured [--scope-delta-reason dispatch-failed|no-declaration|unsafe-path]) | --amend-file F --amend-reason R) [--phase PH] | work-get --slug S | work-list | epic-set --slug S [--title T] [--source SRC] [--goal G] [--branch B] [--premortem P] [--concurrency N] [--status ST] | epic-story-set --epic E --slug S [--title T] [--source SRC] [--criteria C] [--decisions D] [--carried-findings F] [--deps D] [--gates G] [--status ST] [--reason R] [--worktree P] [--bump-retry GATE] [--reset-retry GATE] | epic-get --slug S | epic-reconcile --slug S | epic-list | worktree-path --slug S [--story ST | --json] | evidence-append --command C --exit-code N --output-digest D --origin interactive|subagent [--agent-type T] | evidence-list [--branch B] [--dedupe] | gc [--force]}" >&2; exit 2 ;;
esac
