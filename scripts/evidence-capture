#!/usr/bin/env python3
"""jig's evidence-capture script (story build-scripts, issue #14).

Writes a task's verification artifacts (from `verify` and/or
`worktree-setup`) to `.studious/build-evidence/<date>-<task>-<branch-slug>/`
under the MAIN checkout (see `_gitutil.build_evidence_root`), with a manifest
recording timestamp, commit SHA, branch, and producer per artifact — the
paper trail `/ship` assembles into the PR body. Local, gitignored; evidence
never enters the repo.

The branch slug is needed because two branches building the same day with
the same `--task` collided as an add/add merge conflict once both targeted
the same base (issue #179). It matches branch *names*, not branches: two
repos' same-named branches still collide, as do `feat/foo` and `feat-foo`
(`branch_slug()` collapses '/' to '-'). Detached HEAD always slugs to the
literal "HEAD" (`_gitutil.current_branch`), so a detached writer and reader
on the same checkout agree — not reachable via the normal `worktree add -b`
path, but not fixable by slugging either.

**Rolling the slug back is not the revert alone.** A reader matching
`<date>-<task>` exactly just misses a slug-bearing folder (correct: visible
"not found"). A reader that globs `<date>-<task>*` matches both a legacy and
a new folder for the same task/date (this repo has `2026-07-17-2` beside
`2026-07-17-2-retroactive-inspection`) and can silently emit the wrong branch's link.
A rollback also removes or renames the slug-bearing folders.

Three modes — capture is the default and takes no verb word:

    evidence-capture --task T --artifact P:L=F ...   capture
    evidence-capture resolve --branch B --task T     print that task's folder
    evidence-capture list --branch B                 print each task's answer

`resolve`/`list` are the one home for "which folder belongs to which task" —
callers (`/ship`) use them instead of rebuilding a folder name, or keying on
task+date, which can't tell two branches' same-tasked folders apart once one
merges into the other's base. One rule, both verbs:

1. **A branch-bearing match wins**: among manifests whose `branch` and `task`
   both match, the newest by `captured_at`.
2. **A legacy match (no `branch` field) is used only if it's the unique one
   for that task** — not hypothetical: a project that ran `/build` on two
   different days repeats task ids across dates by default. A unique legacy
   match answers, but answers *any* branch alike, so the answer carries a
   third token, `[legacy]`, on stderr — beside the ordinary exit 0 and the ordinary path on
   stdout. One legacy folder and two are the same
   epistemic state; only the tiebreak differs. A caller promotes a `[legacy]` answer with its
   caveat, or not at all.
3. **Zero matches, or several with no tiebreak, resolve to nothing** — never
   a guess. Reported as distinct literal tokens, `[no-match]` vs
   `[ambiguous]`, so callers can select on the token rather than parse prose
   that the next edit rewrites. `[ambiguous]` is not a claim the branch has
   evidence — this repo's own tasks `1`-`4` each hit it via two branch-less
   manifests sharing a task id. The refusal lists the candidate folders;
   adopting one is a human decision after reading its `manifest.json`.

`list`'s answer column is one grammar: a path, optionally prefixed by a
bracketed token (`[ambiguous]` alone, `[legacy]` before its path) — so a
tab-split row always yields the same two fields, and a caveat can't be lost
by a reader that only looks at the path. The token's meaning is stated once,
in `legacy_note`, and printed identically by both verbs on stderr, since a
`list`-only reader would otherwise see a bare token with its meaning stated
only on `resolve`'s path.

`list` also has to *say* `[ambiguous]` as a row rather than drop the task,
so its inventory doesn't disagree with what a per-task `resolve` on the same
task would say. A task with no bearing on the branch at all (`[no-match]`)
is genuinely absent from the inventory.

Freshness rule (acceptance criteria: "timestamp >= last code commit"): naive
`now >= last-commit-timestamp` is vacuous when the task's work is still
uncommitted, since "last commit" then means the pre-task baseline and any
wall-clock stamp trivially passes (docs/studious/premortems/build-scripts.md,
risk #1). Two defenses:

1. The working tree must be clean at capture time.
2. Every artifact's mtime must be >= the last commit's timestamp — catches
   an artifact copied forward from an earlier stale/failed attempt even when
   the tree happens to be clean for an unrelated reason.

Exit codes, per mode:

  capture  0 captured. 1 freshness refusal (dirty tree, stale artifact,
           clock skew). 2 usage error (bad args, missing artifact, existing
           target dir without --force, or a --force target that's non-empty
           with no manifest.json).
  resolve  0 answered (path on stdout; `[legacy]` note on stderr if rule 2
           applied). 1 resolved to nothing — no match or ambiguous legacy
           matches, distinguished by the printed token. 2 usage error
           (missing --branch, malformed task id).
  list     0 always, including an empty answer (a branch with no captures
           yet is a normal state, not an error) — an `[legacy]` row prints
           the same stderr note `resolve` does. 2 usage error (missing
           --branch).
"""
from __future__ import annotations

import argparse
import json
import re
import shutil
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import NamedTuple

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _gitutil import (  # noqa: E402
    branch_slug,
    build_evidence_root,
    current_branch,
    git_repo_root,
    last_commit_sha_and_epoch,
    run,
)

DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")

QUERY_VERBS = ("resolve", "list")

# Literal tokens a lookup prints for the reader's state, not the rule that
# produced them (that lives in the module docstring). A prompt selects on the
# token rather than parsing an English sentence. NO_MATCH/AMBIGUOUS accompany
# a refusal (exit 1); LEGACY accompanies an answer (exit 0) since one legacy
# folder and two are the same epistemic state.
NO_MATCH = "no-match"
AMBIGUOUS = "ambiguous"
LEGACY = "legacy"

# Any identifier flowing into a destination path (--task; an --artifact's
# PRODUCER/LABEL) must be a plain token — no '/' or '..' to escape the
# evidence directory. One shared allowlist rather than three separate ones
# (issue #51: --task was guarded, --artifact label was not).
SAFE_IDENTIFIER_RE = re.compile(r"^[A-Za-z0-9_.-]+$")


def _check_safe_identifier(value: str, field: str) -> None:
    """Raise ValueError unless `value` is a plain path-safe identifier.

    The regex allows '.' (for labels like "v1.2"), so '.' and '..' pass it
    too. A no-suffix source + '..' label collapses `dest_name` to exactly
    '..', which shutil.copy2 resolves to the evidence dir's parent instead
    of refusing (issue #60) — reject both exact strings explicitly.
    """
    if value in {".", ".."} or not SAFE_IDENTIFIER_RE.match(value):
        raise ValueError(
            f"{field} '{value}' must be a plain identifier matching [A-Za-z0-9_.-]+ and not be '.' or '..'"
        )


def parse_artifact_spec(spec: str) -> tuple[str, str, Path]:
    """Parse a `PRODUCER:LABEL=PATH` --artifact value."""
    if "=" not in spec:
        raise ValueError(f"--artifact '{spec}' must be of the form PRODUCER:LABEL=PATH")
    head, _, path_str = spec.partition("=")
    if ":" not in head:
        raise ValueError(f"--artifact '{spec}' must be of the form PRODUCER:LABEL=PATH")
    producer, _, label = head.partition(":")
    if not producer or not label or not path_str:
        raise ValueError(f"--artifact '{spec}' must be of the form PRODUCER:LABEL=PATH")
    _check_safe_identifier(producer, "--artifact producer")
    _check_safe_identifier(label, "--artifact label")
    return producer, label, Path(path_str)


def load_manifests(evidence_root: Path) -> list[tuple[Path, dict]]:
    """Every (folder, manifest) pair under `evidence_root`, in folder order.

    A missing, unreadable, or non-object manifest is skipped rather than
    raised on — one malformed folder shouldn't fail every query.
    """
    if not evidence_root.is_dir():
        return []
    entries: list[tuple[Path, dict]] = []
    for folder in sorted(evidence_root.iterdir()):
        if not folder.is_dir():
            continue
        try:
            manifest = json.loads((folder / "manifest.json").read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if isinstance(manifest, dict):
            entries.append((folder, manifest))
    return entries


class Resolution(NamedTuple):
    """A lookup's answer: a folder or nothing, the token qualifying it, and the near misses.

    `token` is empty only for a branch-bearing match. `candidates` is carried
    rather than recomputed by the caller so a refusal can enumerate the
    folders it couldn't pick between.
    """

    folder: Path | None
    token: str
    candidates: tuple[Path, ...] = ()


def resolve_folder(entries: list[tuple[Path, dict]], branch: str, task: str) -> Resolution:
    """Apply the resolution rule (stated once, in the module docstring).

    `branch` is matched as a *name*, never a slug — a slug would collapse
    `feat/foo` and `feat-foo` back together.
    """
    branch_bearing = [
        (folder, manifest)
        for folder, manifest in entries
        if manifest.get("branch") == branch and manifest.get("task") == task
    ]
    if branch_bearing:
        newest = max(branch_bearing, key=lambda pair: (str(pair[1].get("captured_at") or ""), pair[0].name))
        return Resolution(newest[0], "")

    legacy = [
        folder for folder, manifest in entries if not manifest.get("branch") and manifest.get("task") == task
    ]
    if len(legacy) == 1:
        return Resolution(legacy[0], LEGACY)
    return Resolution(None, AMBIGUOUS if legacy else NO_MATCH, tuple(legacy))


def list_branch_tasks(entries: list[tuple[Path, dict]], branch: str) -> list[tuple[str, Resolution]]:
    """Every task `branch` has an answer for, task-sorted, one row each.

    An undecidable task is a row, not an omission (see module docstring on
    `[ambiguous]`); a task with no bearing on this branch is absent.
    """
    tasks = sorted({m["task"] for _, m in entries if isinstance(m.get("task"), str)})
    rows = ((task, resolve_folder(entries, branch, task)) for task in tasks)
    return [(task, row) for task, row in rows if row.folder is not None or row.token == AMBIGUOUS]


def display_path(folder: Path, repo: Path) -> str:
    """Always absolute, deliberately.

    `evidence-freshness --evidence` resolves relative paths against its own
    cwd; a relative print broke that once cwd wasn't what was assumed (exit
    2, "no manifest.json found"). `repo` stays a parameter for call-site
    signature stability; it no longer shapes the output.
    """
    del repo
    return str(folder.resolve())


def answer_column(row: Resolution, repo: Path) -> str:
    """A `list` row's answer field: a path, a bracketed token, or a token then a path.

    One column, one grammar, so a tab-split row always yields two fields.
    """
    if row.folder is None:
        return f"[{row.token}]"
    path = display_path(row.folder, repo)
    return f"[{row.token}] {path}" if row.token else path


def legacy_note(task: str, branch: str, answer: str) -> str:
    """The one stderr caveat both query verbs print for a rule-2 (`[legacy]`) answer."""
    return (
        f"note: [{LEGACY}] the folder resolved for task '{task}' records no branch, so "
        f"nothing ties it to '{branch}' — it predates the manifest's branch field and may "
        f"belong to a branch that has already merged; read {answer}/manifest.json before "
        "promoting it as this item's evidence."
    )


def ambiguous_note(task: str, branch: str, answers: tuple[str, ...]) -> str:
    """The stderr caveat `list` prints for a rule-3 undecidable row.

    Not shared with `resolve` (which refuses, exit 1) since `list` answers
    with an ordinary row (exit 0) instead — same token meaning, stated here
    too. Carries no recovery text; that stays single-sourced in `resolve`'s
    refusal.
    """
    return (
        f"note: [{AMBIGUOUS}] no folder resolved for task '{task}' on branch '{branch}': "
        f"{len(answers)} folders record that task and none of them records a branch, so "
        f"nothing here says this branch captured any of it — {', '.join(answers)}. Each "
        "predates the manifest's branch field and may belong to a branch that has already "
        "merged."
    )


def clear_directory(target_dir: Path) -> int:
    """Remove every entry inside `target_dir`; return how many were removed.

    Count returned so the caller can report the destructive half of a --force run.
    """
    entries = list(target_dir.iterdir())
    for entry in entries:
        if entry.is_dir() and not entry.is_symlink():
            shutil.rmtree(entry)
        else:
            entry.unlink()
    return len(entries)


def usage_modes() -> str:
    """The three-mode usage block, lifted from this module's own docstring so `--help` can't drift from it."""
    lines = [line for line in (__doc__ or "").splitlines() if line.strip().startswith("evidence-capture ")]
    return "\n".join(["Three modes — capture is the default and takes no verb word:", "", *lines])


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="evidence-capture",
        description=(
            "Write a task's verification artifacts + a freshness-stamped manifest to "
            "the main checkout's .studious/build-evidence/<date>-<task>-<branch-slug>/."
        ),
        epilog=usage_modes(),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--task", required=True, help="task identifier (used in the evidence directory name)")
    parser.add_argument("--repo", default=".", help="path to the git repo the evidence is checked against")
    parser.add_argument(
        "--date", default=None, help="evidence date, YYYY-MM-DD (default: today, UTC)"
    )
    parser.add_argument(
        "--evidence-root",
        default=None,
        help="root directory evidence folders are created under (default: the main checkout's .studious/build-evidence)",
    )
    parser.add_argument(
        "--artifact",
        action="append",
        default=[],
        metavar="PRODUCER:LABEL=PATH",
        help="an artifact to capture, repeatable; PRODUCER names the script that produced it (e.g. verify)",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="re-capture into an existing evidence directory, clearing its contents first",
    )
    return parser.parse_args(argv)


def parse_query_args(verb: str, argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog=f"evidence-capture {verb}",
        description=(
            "Print the evidence folder for a branch + task."
            if verb == "resolve"
            else "Print every task that has an evidence folder for a branch, one per line."
        ),
    )
    parser.add_argument("--branch", required=True, help="branch name to resolve for (a name, never a slug)")
    if verb == "resolve":
        parser.add_argument("--task", required=True, help="task identifier to resolve")
    parser.add_argument("--repo", default=".", help="path to the git repo the evidence lives in")
    parser.add_argument(
        "--evidence-root",
        default=None,
        help="root directory evidence folders live under (default: the main checkout's .studious/build-evidence)",
    )
    return parser.parse_args(argv)


def run_query(verb: str, argv: list[str]) -> int:
    args = parse_query_args(verb, argv)

    repo = git_repo_root(Path(args.repo))
    if repo is None:
        print(f"error: '{args.repo}' is not inside a git repository", file=sys.stderr)
        return 2

    evidence_root = Path(args.evidence_root) if args.evidence_root else build_evidence_root(repo)
    entries = load_manifests(evidence_root)

    if verb == "list":
        for task, row in list_branch_tasks(entries, args.branch):
            # stdout row grammar is unchanged; the note (what the token means) goes to stderr.
            if row.folder is not None and row.token == LEGACY:
                print(legacy_note(task, args.branch, display_path(row.folder, repo)), file=sys.stderr)
            elif row.token == AMBIGUOUS:
                answers = tuple(display_path(candidate, repo) for candidate in row.candidates)
                print(ambiguous_note(task, args.branch, answers), file=sys.stderr)
            print(f"{task}\t{answer_column(row, repo)}")
        return 0

    try:
        _check_safe_identifier(args.task, "--task")
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    row = resolve_folder(entries, args.branch, args.task)
    if row.folder is None:
        if row.token == AMBIGUOUS:
            listed = "\n  ".join(display_path(candidate, repo) for candidate in row.candidates)
            print(
                f"error: [{AMBIGUOUS}] evidence for task '{args.task}' cannot be tied to "
                f"branch '{args.branch}': {len(row.candidates)} folders under {evidence_root} "
                "record that task and none of them records a branch, so nothing here says "
                "this branch captured any of it —\n  "
                f"{listed}\n"
                "Each predates the manifest's branch field and may well belong to a branch "
                "that has already merged. If this branch verified the task, capture on this "
                "branch. The only other repair is to edit one of those manifests — add this "
                "branch to it, or give its task a distinct id — and only after reading its "
                "manifest.json and confirming the folder is this item's evidence. Renaming "
                "the folder repairs nothing: resolution keys on the manifest's branch and "
                "task, never on a folder name, so a rename leaves both of these branch-less "
                "and still colliding.",
                file=sys.stderr,
            )
        else:
            print(
                f"error: [{NO_MATCH}] no evidence found for task '{args.task}' on branch "
                f"'{args.branch}' under {evidence_root}",
                file=sys.stderr,
            )
        return 1

    answer = display_path(row.folder, repo)
    # Exit stays 0, stdout stays the bare path; the caveat goes to stderr.
    if row.token == LEGACY:
        print(legacy_note(args.task, args.branch, answer), file=sys.stderr)
    print(answer)
    return 0


def run_capture(argv: list[str]) -> int:
    args = parse_args(argv)

    if not args.artifact:
        print("error: at least one --artifact is required", file=sys.stderr)
        return 2
    try:
        _check_safe_identifier(args.task, "--task")
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    if args.date is not None and not DATE_RE.match(args.date):
        print(f"error: --date '{args.date}' must be YYYY-MM-DD", file=sys.stderr)
        return 2

    try:
        specs = [parse_artifact_spec(a) for a in args.artifact]
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    labels = [label for _, label, _ in specs]
    if len(labels) != len(set(labels)):
        print(f"error: --artifact labels must be unique, got {labels}", file=sys.stderr)
        return 2

    repo = git_repo_root(Path(args.repo))
    if repo is None:
        print(f"error: '{args.repo}' is not inside a git repository", file=sys.stderr)
        return 2

    dirty = run(["git", "-C", str(repo), "status", "--porcelain"]).stdout
    if dirty.strip():
        print(
            "error: refusing to capture evidence against an uncommitted working "
            "tree — evidence must be checked against a real commit. Commit the "
            "task's work first, then re-run evidence-capture.\n"
            f"dirty files:\n{dirty}",
            file=sys.stderr,
        )
        return 1

    commit_info = last_commit_sha_and_epoch(repo)
    if commit_info is None:
        print(f"error: could not read the last commit in '{repo}'", file=sys.stderr)
        return 2
    commit_sha, commit_epoch = commit_info

    now = time.time()
    if now < commit_epoch:
        print(
            "error: system clock appears to be behind the last commit's timestamp; "
            "refusing to stamp evidence",
            file=sys.stderr,
        )
        return 1

    missing = [str(path) for _, _, path in specs if not path.is_file()]
    if missing:
        print(f"error: artifact(s) not found: {', '.join(missing)}", file=sys.stderr)
        return 2

    stale = [str(path) for _, _, path in specs if path.stat().st_mtime < commit_epoch]
    if stale:
        print(
            "error: refusing to capture stale evidence — the following artifact(s) "
            f"predate the last commit ({commit_sha[:8]}) they're supposed to "
            "evidence, and were likely copied forward from a prior attempt:\n  "
            + "\n  ".join(stale),
            file=sys.stderr,
        )
        return 1

    cleared = 0
    date = args.date or datetime.now(timezone.utc).strftime("%Y-%m-%d")
    evidence_root = Path(args.evidence_root) if args.evidence_root else build_evidence_root(repo)
    branch = current_branch(repo)
    # Field order keeps <date>-<task> byte-stable with legacy names as a
    # prefix — affordable since resolve reads manifests, not the folder name.
    target_dir = evidence_root / f"{date}-{args.task}-{branch_slug(branch)}"

    if target_dir.exists():
        if not args.force:
            print(
                f"error: evidence directory already exists: {target_dir}\n"
                "Pass --force to clear it and re-capture, or remove it first if this is a stale capture.",
                file=sys.stderr,
            )
            return 2
        if not target_dir.is_dir():
            print(f"error: {target_dir} exists and is not a directory", file=sys.stderr)
            return 2
        # --force clears before copying so the folder can't disagree with its
        # own manifest (issue #224): a stale differently-labelled artifact
        # used to survive beside a rewritten manifest that no longer listed
        # it, and evidence-freshness only checks *listed* artifacts.
        #
        # Only clear directories recognizable as this script's own output —
        # --force authorizes replacing evidence, not deleting an
        # unrecognizable directory (e.g. a capture that crashed after
        # copying but before writing its manifest).
        if any(target_dir.iterdir()) and not (target_dir / "manifest.json").is_file():
            print(
                f"error: refusing to clear {target_dir}: it is not empty and carries no "
                "manifest.json, so it is not recognizable as an evidence directory (a capture "
                "that crashed before writing its manifest leaves exactly this shape).\n"
                f"Remove it and re-run: rm -rf {target_dir}",
                file=sys.stderr,
            )
            return 2
        cleared = clear_directory(target_dir)

    target_dir.mkdir(parents=True, exist_ok=True)

    manifest_artifacts = []
    for producer, label, path in specs:
        dest_name = f"{label}{path.suffix}"
        shutil.copy2(path, target_dir / dest_name)
        manifest_artifacts.append({"producer": producer, "label": label, "source": str(path), "path": dest_name})

    manifest = {
        "task": args.task,
        "date": date,
        # The branch *name*, not its slug — keeps feat/foo and feat-foo distinguishable.
        "branch": branch,
        "commit_sha": commit_sha,
        "commit_timestamp": datetime.fromtimestamp(commit_epoch, tz=timezone.utc).isoformat(),
        "captured_at": datetime.now(timezone.utc).isoformat(),
        "artifacts": manifest_artifacts,
    }
    (target_dir / "manifest.json").write_text(json.dumps(manifest, indent=2), encoding="utf-8")

    # Report a clear first: "wrote N artifacts" alone hides whether the
    # folder held someone else's capture. Also flags that a cleared commit
    # leaves an uncommitted deletion — the generic dirty-tree refusal above
    # would otherwise misattribute it to uncommitted task work.
    cleared_note = (
        f"cleared {cleared} pre-existing entr{'y' if cleared == 1 else 'ies'} "
        "(clearing committed evidence leaves uncommitted deletions — commit them before the next capture); "
        if cleared
        else ""
    )
    print(
        f"evidence-capture: {cleared_note}wrote {len(manifest_artifacts)} artifact(s) "
        f"+ manifest.json to {target_dir}"
    )
    return 0


def main(argv: list[str]) -> int:
    """Dispatch on a bare first argument, defaulting to capture.

    Every capture invocation starts with a flag (`--task` is required), so a
    leading bare word is unambiguously a verb.
    """
    if argv and not argv[0].startswith("-"):
        verb = argv[0]
        if verb not in QUERY_VERBS:
            print(
                f"error: unknown verb '{verb}'; expected one of {', '.join(QUERY_VERBS)}, "
                "or capture arguments beginning with --task",
                file=sys.stderr,
            )
            return 2
        return run_query(verb, argv[1:])
    return run_capture(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
