#!/usr/bin/env python3
"""retro-stats — render one cycle's numbers from the ledger, for `/retro` (#330).

Code owns the counting; the door narrates. Every `.studious/` read goes through
`bin/gate-ledger` verbs — `work-list`/`work-get`, `gate-get`, `episode-get
--branch`, `evidence-list` — never a raw file. The one store with no read verb
is read as a file, by its own contract: `docs/studious/decisions.jsonl`
(`reference/decision-journal-format.md`).

Each table names the record it came from, and a number the store does not hold
renders as an honest gap ("—", "unmeasured", "none recorded"), never a zero.

`--since YYYY-MM-DD` narrows the window on each record's own stamp: `updatedAt`
(work files), `capturedAt` (evidence), `date` (decisions). Timestamps compare as fixed-width strings — `datetime.fromisoformat`
rejects the trailing `Z` below 3.11, a runtime break under this directory's 3.9
floor that vermin can't see.

Exit codes: 0 always, including an empty store (prints the no-data line);
2 usage error or no `bin/gate-ledger` beside this script.
"""
from __future__ import annotations

import argparse
import json
import re
import shutil
import statistics
import sys
from collections import Counter, defaultdict
from datetime import datetime
from pathlib import Path
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _gitutil import main_checkout_root, run  # noqa: E402

GATE_LEDGER = Path(__file__).resolve().parent.parent / "bin" / "gate-ledger"
NO_DATA = "no cycle data in this clone"
#: The episode gates `bin/gate-ledger` records rounds for (`reference/gate-vocabulary.md`).
GATES = ("design-review", "audit", "acceptance")
#: Story-timeline steps, in flow order (`commands/next.md`), for the time-per-phase table.
PHASES = ("decide", "design", "design-review", "build", "audit", "acceptance", "merge", "finish")
#: A session boundary, not work — never attributed to a phase's wall time.
RUN_BOUNDARY = "run-boundary"
STAMP = "%Y-%m-%dT%H:%M:%SZ"

EPISODE_LINE = re.compile(
    r"^episode (?P<n>\d+)(?P<current> \(current\))? — opened \S+ at \S+, "
    r"round (?P<round>\d+) of (?P<cap>\d+), (?:verdict (?P<verdict>.+?)|no verdict yet) — "
    r"(?P<open>\d+) open, (?P<carried>\d+) carried$"
)


class Ledger:
    """`bin/gate-ledger`, run against one main checkout; stdout or "" on any failure.

    A failed call (nonzero exit, or the binary can't even start) is recorded in
    `errors` — distinct from a verb that legitimately printed nothing for an
    empty store. Both return `""` from `out`, but only the render layer knows
    which one a human needs to see as "no cycle data" versus an error.
    """

    def __init__(self, exe: Path, root: Path) -> None:
        self.exe = exe
        self.root = root
        self.errors: list[str] = []

    def out(self, *args: str) -> str:
        try:
            proc = run([str(self.exe), *args], cwd=self.root)
        except OSError as exc:
            self.errors.append(f"{' '.join(args)}: {exc}")
            return ""
        if proc.returncode != 0:
            cause = next((line.strip() for line in (proc.stderr or "").splitlines() if line.strip()), "")
            detail = f" — {cause}" if cause else ""
            self.errors.append(f"{' '.join(args)}: exit {proc.returncode}{detail}")
            return ""
        return proc.stdout

    def json(self, *args: str) -> dict[str, Any]:
        text = self.out(*args).strip()
        if not text:
            return {}
        try:
            record = json.loads(text)
        except ValueError:
            return {}
        return record if isinstance(record, dict) else {}

    def tsv(self, *args: str) -> list[list[str]]:
        return [line.split("\t") for line in self.out(*args).splitlines() if line.strip()]


def parse_jsonl(text: str) -> list[dict[str, Any]]:
    """Every well-formed object in `.jsonl` text; a malformed line is skipped, never fatal."""
    out: list[dict[str, Any]] = []
    for line in text.splitlines():
        try:
            record = json.loads(line) if line.strip() else None
        except ValueError:
            continue
        if isinstance(record, dict):
            out.append(record)
    return out


def read_jsonl(path: Path) -> list[dict[str, Any]]:
    try:
        return parse_jsonl(path.read_text(encoding="utf-8", errors="replace"))
    except OSError:
        return []


def in_window(stamp: str, since: str) -> bool:
    return not since or str(stamp)[:10] >= since


def parse_stamp(stamp: str) -> datetime | None:
    try:
        return datetime.strptime(stamp, STAMP)
    except (TypeError, ValueError):
        return None


def branch_of(work: dict[str, Any]) -> str:
    branch = str(work.get("branch") or "")
    return branch if branch and branch != "-" else str(work.get("slug", "?"))


def phase_durations(work: dict[str, Any]) -> list[tuple[str, float]]:
    """(step, hours) per history entry, measured from the entry before it (or `createdAt`).

    An interval touching a `run-boundary` entry on either end is dropped — that is
    time the driver was not running, not time a phase took. A negative interval
    (a stamp recorded out of order — clock skew, a retried write) is dropped too:
    it isn't a phase taking negative time, and `hours()` would render it as a
    bogus negative duration otherwise.
    """
    history = [h for h in work.get("history", []) if isinstance(h, dict)]
    prior_step, prior_at = "", parse_stamp(str(work.get("createdAt", "")))
    out: list[tuple[str, float]] = []
    for entry in history:
        step, at = str(entry.get("step", "")), parse_stamp(str(entry.get("at", "")))
        if at and prior_at and RUN_BOUNDARY not in (step, prior_step) and step in PHASES:
            delta = (at - prior_at).total_seconds() / 3600
            if delta >= 0:
                out.append((step, delta))
        prior_step, prior_at = step, at or prior_at
    return out


def hours(value: float) -> str:
    """Render a non-negative duration. Callers must never pass a negative interval —
    `phase_durations` drops those before this is reached, rather than rendering `-24m`."""
    return f"{value:.1f}h" if value >= 1 else f"{value * 60:.0f}m"


def collect(ledger: Ledger, root: Path, since: str) -> dict[str, Any]:
    # Every gate-ledger verb below opens `if ! have jq; then return 0; fi` — a
    # clean exit 0 with empty stdout, so `Ledger.errors` never records a missing
    # jq as a failure. Without jq, every one of the flags below is unmeasured
    # regardless of what its own before/after error count says; the decisions
    # journal is read as a file, not a ledger verb, so jq's absence doesn't
    # touch it.
    jq_missing = shutil.which("jq") is None
    before = len(ledger.errors)
    work_rows = ledger.tsv("work-list")
    work_list_failed = len(ledger.errors) > before
    before = len(ledger.errors)
    works = [ledger.json("work-get", "--slug", row[0]) for row in work_rows if row and row[0] not in ("", "?")]
    work_get_failed = len(ledger.errors) > before
    works = [w for w in works if w and in_window(str(w.get("updatedAt", "")), since)]
    branches = sorted({branch_of(w) for w in works if w.get("branch")})
    before = len(ledger.errors)
    gates = {b: ledger.json("gate-get", "--branch", b) for b in branches}
    gates_failed = len(ledger.errors) > before
    before = len(ledger.errors)
    episodes = {
        (b, g): ledger.out("episode-get", "--gate", g, "--history", "--branch", b).splitlines()
        for b in branches
        for g in GATES
    }
    episodes_failed = len(ledger.errors) > before
    before = len(ledger.errors)
    episode_findings = {
        (b, g): [
            row
            for row in ledger.tsv("episode-get", "--gate", g, "--findings", "--branch", b)
            if row[0] in ("open", "carried", "digest")
        ]
        for b in branches
        for g in GATES
    }
    episode_findings_failed = len(ledger.errors) > before
    before = len(ledger.errors)
    evidence = {
        b: [
            r
            for r in parse_jsonl(ledger.out("evidence-list", "--branch", b))
            if in_window(str(r.get("capturedAt", "")), since)
        ]
        for b in branches
    }
    evidence_failed = len(ledger.errors) > before
    decisions_file = root / "docs" / "studious" / "decisions.jsonl"
    decisions = [r for r in read_jsonl(decisions_file) if in_window(str(r.get("date", "")), since)]
    return {
        "works": works,
        "branches": branches,
        "gates": gates,
        "episodes": episodes,
        "episode_findings": episode_findings,
        "evidence": evidence,
        "decisions": decisions,
        "has_journal": decisions_file.is_file(),
        "ledger_errors": list(ledger.errors),
        "work_list_failed": work_list_failed or jq_missing,
        "work_get_failed": work_get_failed or jq_missing,
        "jq_missing": jq_missing,
        "gates_failed": gates_failed or jq_missing,
        "episodes_failed": episodes_failed or jq_missing,
        "episode_findings_failed": episode_findings_failed or jq_missing,
        "evidence_failed": evidence_failed or jq_missing,
    }


def table(header: list[str], rows: list[list[str]]) -> list[str]:
    return [
        "| " + " | ".join(header) + " |",
        "|" + "|".join("---" for _ in header) + "|",
        *("| " + " | ".join(row) + " |" for row in rows),
    ]


def stories_section(data: dict[str, Any]) -> list[str]:
    phases = Counter(str(w.get("phase", "?")) for w in data["works"])
    rows = [[phase, str(n)] for phase, n in sorted(phases.items())]
    lines = ["## Stories (`work-list`)", ""]
    if rows:
        lines += table(["Phase", "Work files"], rows)
    else:
        lines += ["unmeasured — `work-list` errored"] if data["work_list_failed"] else ["no work file recorded"]
    return lines


def rounds_section(data: dict[str, Any]) -> list[str]:
    rows = []
    sources: list[tuple[str, list[dict[str, Any]]]] = [
        (branch_of(w), [h for h in w.get("history", []) if isinstance(h, dict)]) for w in data["works"]
    ]
    for branch, history in sources:
        for gate in GATES:
            entries = [h for h in history if h.get("step") == gate]
            episodes = [EPISODE_LINE.match(line) for line in data["episodes"].get((branch, gate), [])]
            matched = [m for m in episodes if m]
            escalated = any(line.startswith("escalated\t") for line in data["episodes"].get((branch, gate), []))
            # A gate recorded with bare `record` opens no episode: the verdict
            # lives in `gate-get`'s `.gates[<gate>]` only.
            record = ((data["gates"].get(branch) or {}).get("gates") or {}).get(gate) or {}
            if not entries and not matched and not record:
                continue
            ledger_cell = "unmeasured" if data["episodes_failed"] else "—"
            if matched:
                last = matched[-1]
                ledger_cell = f"{len(matched)} episode(s), round {last.group('round')} of {last.group('cap')}, {last.group('verdict') or 'no verdict yet'}"
                ledger_cell += ", escalated" if escalated else ""
            elif record:
                ledger_cell = f"no episode — `record` {record.get('verdict', '?')} at {record.get('sha', '?')}"
            rows.append(
                [
                    f"`{branch}`",
                    gate,
                    str(len(entries)) if entries else "—",
                    str(entries[-1].get("outcome", "?")) if entries else "—",
                    ledger_cell,
                ]
            )
    lines = ["## Rounds per episode (`work-get` history, `episode-get --history`)", ""]
    if rows:
        lines += table(["Story", "Gate", "Rounds logged", "Last outcome", "Episode ledger"], rows)
    else:
        lines += ["unmeasured — `episode-get --history` errored"] if data["episodes_failed"] else ["no gate round logged"]
    return lines


def lanes_section(data: dict[str, Any]) -> list[str]:
    per_lane: dict[str, Counter] = defaultdict(Counter)
    for (branch, gate), rows in data["episode_findings"].items():
        # A digest line carries lane, fingerprint, status, round — not severity;
        # that is read back from the same branch's `gate-get` record.
        recorded = {
            fp: str(f.get("severity", ""))
            for episode in [*(data["gates"].get(branch, {}).get("episodeHistory") or {}).get(gate, []),
                            (data["gates"].get(branch, {}).get("episodes") or {}).get(gate) or {}]
            for fp, f in (episode.get("findings") or {}).items()
            if isinstance(f, dict)
        }
        for row in rows:
            if len(row) < 4:
                continue
            if row[0] == "digest":
                lane, status, severity = row[1], row[3], recorded.get(row[2], "")
            else:
                status, severity, lane = row[0], row[1], row[2]
            per_lane[lane]["findings"] += 1
            per_lane[lane][status] += 1
            per_lane[lane]["Critical"] += severity == "Critical"
    for record in data["gates"].values():
        for entry in (record.get("gates") or {}).values():
            if isinstance(entry, dict):
                for lane in entry.get("blockingLanes") or []:
                    per_lane[str(lane)]["blocking"] += 1
    rows = [
        [
            f"`{lane}`",
            str(c["findings"]),
            str(c["Critical"]),
            str(c["open"] + c["carried"]),
            str(c["waived"]),
            str(c["rejected-as-noise"]),
            str(c["blocking"]),
        ]
        for lane, c in sorted(per_lane.items(), key=lambda kv: (-kv[1]["findings"], kv[0]))
    ]
    failed_verbs = [
        verb
        for verb, failed in (
            ("`episode-get --findings`", data["episode_findings_failed"]),
            ("`gate-get`", data["gates_failed"]),
        )
        if failed
    ]
    lines = ["## Lanes (`episode-get --findings`, `gate-get` blockingLanes)", ""]
    if rows:
        lines += table(["Lane", "Findings", "Critical", "Unresolved", "Waived", "Ruled noise", "Named blocking"], rows)
    elif failed_verbs:
        lines += [f"unmeasured — {', '.join(failed_verbs)} errored"]
    else:
        lines += ["no finding recorded in either ledger"]
    if rows and failed_verbs:
        lines += ["", f"unmeasured: {', '.join(failed_verbs)} errored on at least one call — counts above may undercount"]
    return lines


def scope_section(data: dict[str, Any]) -> list[str]:
    rows, undeclared = [], 0
    for work in data["works"]:
        declared, moments = work.get("declaredFiles"), [m for m in work.get("scopeDelta") or [] if isinstance(m, dict)]
        if declared is None and not moments:
            undeclared += 1
            continue
        measured = [m for m in moments if not m.get("unmeasured")]
        outside = {f for m in measured for f in m.get("outsideFiles") or []}
        unmeasured = [f"{m.get('phase', '?')} ({m.get('reason', 'unspecified')})" for m in moments if m.get("unmeasured")]
        rows.append(
            [
                f"`{branch_of(work)}`",
                str(len(declared)) if declared is not None else "never declared",
                str(len(outside)) if measured else "unmeasured",
                f"{len(measured)} of {len(moments)}",
                ", ".join(unmeasured) or "—",
                str(len(work.get("amendments") or [])),
            ]
        )
    lines = ["## Scope: declared vs outside (`work-get` declaredFiles, scopeDelta)", ""]
    if rows:
        lines += table(["Story", "Declared", "Outside", "Moments measured", "Unmeasured (reason)", "Amendments"], rows)
    else:
        lines += ["unmeasured — `work-list`/`work-get` errored"] if (data["work_list_failed"] or data["work_get_failed"]) else ["no story declared a file set"]
    if undeclared:
        lines += ["", f"Never declared, never measured: {undeclared} work file(s)"]
    return lines


def time_section(data: dict[str, Any]) -> list[str]:
    per_phase: dict[str, list[float]] = defaultdict(list)
    for work in data["works"]:
        for step, value in phase_durations(work):
            per_phase[step].append(value)
    rows = [
        [phase, str(len(values)), hours(statistics.median(values)), hours(max(values)), hours(sum(values))]
        for phase in PHASES
        for values in [per_phase.get(phase, [])]
        if values
    ]
    lines = ["## Time per phase (`work-get` history stamps; intervals across a run boundary dropped)", ""]
    if rows:
        lines += table(["Phase", "Intervals", "Median", "Max", "Total"], rows)
    else:
        lines += ["unmeasured — `work-list`/`work-get` errored"] if (data["work_list_failed"] or data["work_get_failed"]) else ["no two stamps to measure between"]
    return lines


def evidence_section(data: dict[str, Any]) -> list[str]:
    rows = [
        [
            f"`{branch}`",
            str(len({str(r.get('command', '')) for r in records})),
            str(sum(1 for r in records if str(r.get("exitCode", "0")) != "0")),
        ]
        for branch, records in sorted(data["evidence"].items())
        if records
    ]
    lines = ["## Verification evidence (`evidence-list`)", ""]
    if rows:
        lines += table(["Story", "Distinct commands", "Failed runs"], rows)
    else:
        lines += ["unmeasured — `evidence-list` errored"] if data["evidence_failed"] else ["no evidence captured"]
    if rows and data["evidence_failed"]:
        lines += ["", "unmeasured: `evidence-list` errored on at least one call — counts above may undercount"]
    return lines


def decisions_section(data: dict[str, Any]) -> list[str]:
    lines = ["## Bets (`docs/studious/decisions.jsonl`)", ""]
    if not data["has_journal"]:
        return [*lines, "no decision journal"]
    counts = Counter(str(r.get("verdict", "?")) for r in data["decisions"])
    rows = [[verdict, str(n)] for verdict, n in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))]
    return lines + (table(["Verdict", "Count"], rows) if rows else ["no verdict in window"])


def render(data: dict[str, Any], root: Path, since: str) -> str:
    window = f"since {since}" if since else "whole store"
    errors = data["ledger_errors"]
    if not (data["works"] or data["decisions"]):
        if errors:
            return (
                f"gate-ledger errored on {len(errors)} call(s) ({window}) — not the same as "
                f"an empty store; first: {errors[0]}"
            )
        if data["jq_missing"]:
            return f"store unreadable — jq not installed, every gate-ledger read verb no-ops ({window})"
        return f"{NO_DATA} ({window})"
    work_unit = "work file(s)" + (" (undercount — work-get errored)" if data["work_get_failed"] else "")
    work_count = "unmeasured" if data["work_list_failed"] else str(len(data["works"]))
    header = f"# Cycle numbers — {root.name}, {window}: {work_count} {work_unit}, {len(data['branches'])} branch(es)"
    if errors:
        header += f" — gate-ledger errored on {len(errors)} call(s)"
    sections = [
        [header],
        stories_section(data),
        rounds_section(data),
        lanes_section(data),
        scope_section(data),
        time_section(data),
        evidence_section(data),
        decisions_section(data),
    ]
    if errors:
        sections.append([f"## gate-ledger errors ({len(errors)})", "", *(f"- {e}" for e in errors)])
    return "\n\n".join("\n".join(section) for section in sections)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Render one cycle's numbers from the Studious ledger, as Markdown tables.")
    parser.add_argument("--repo", default=".", help="repository to read (default: the main working tree containing cwd)")
    parser.add_argument("--since", default="", help="window start, YYYY-MM-DD (default: the whole store)")
    parser.add_argument("--gate-ledger", default=str(GATE_LEDGER), help="path to bin/gate-ledger (default: the one beside this script)")
    args = parser.parse_args(argv)

    if args.since and not re.fullmatch(r"\d{4}-\d{2}-\d{2}", args.since):
        print("error: --since takes YYYY-MM-DD", file=sys.stderr)
        return 2
    exe = Path(args.gate_ledger)
    if not exe.is_file():
        print(f"error: no gate-ledger at '{exe}'", file=sys.stderr)
        return 2
    root = main_checkout_root(Path(args.repo).resolve())
    print(render(collect(Ledger(exe, root), root, args.since), root, args.since))
    return 0


if __name__ == "__main__":
    sys.exit(main())
