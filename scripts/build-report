#!/usr/bin/env python3
"""jig's build-report script (story finish-skill, issue #20).

`/ship` Step 5: writes docs/studious/build-reports/YYYY-MM-DD-<slug>-build-report.md,
matching studious's dated review-report naming convention.

The slug is the story's work-file slug (#284): with `--slug` omitted, the script
reads `gate-ledger work-list` in `--repo` and takes the row whose branch column
equals the repo's current branch -- exactly one row: two work files recording
one branch would resolve by glob order, so that refuses instead. That is the one
match rule a later reader applies in reverse -- report filename -> work file ->
story. `--slug` overrides it for a branch with no work file (or an ambiguous
one), and is validated the same way.

Mechanical write only -- `/ship` assembles the markdown body and passes it via
--content. Never commits (matches evidence-capture's precedent); the caller
commits separately so the write and the Step 6 cleanup commit stay
distinguishable in history.

Exit codes: 0 written. 2 usage error (bad --slug, bad --date, missing
--content, an existing report without --force, or no work file -- or more than
one -- matching the branch when --slug is omitted).
"""
from __future__ import annotations

import argparse
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Optional

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _gitutil import current_branch  # noqa: E402

DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
GATE_LEDGER = Path(__file__).resolve().parent.parent / "bin" / "gate-ledger"


def branch_to_match(repo: Path) -> Optional[str]:
    """The branch a work file's branch column could name, or None for no branch.

    `_gitutil.current_branch` is the same reader `bin/gate-ledger`'s
    `branch_name()` mirrors -- the writer of that column -- so both sides of the
    match agree by construction. It returns the sentinel "HEAD" when detached or
    unreadable; git forbids a real branch of that name, so mapping it to None
    loses nothing and stops a detached checkout from matching a work file
    captured while detached. Guards OSError -- no `git` on PATH lands on the
    exit-2 refusal, never a traceback (`_gitutil.git_repo_root`'s own idiom).
    """
    try:
        branch = current_branch(repo)
    except OSError:
        return None
    return branch if branch != "HEAD" else None


def work_rows(repo: Path) -> list[list[str]]:
    """`gate-ledger work-list`'s rows (slug, phase, branch, title; tab-separated),
    empty when the ledger can't be run or reports nothing."""
    try:
        r = subprocess.run(
            [str(GATE_LEDGER), "work-list"], cwd=str(repo),
            capture_output=True, text=True, check=False,
        )
    except OSError:  # gate-ledger missing or not executable -- same refusal
        return []
    if r.returncode != 0:
        return []
    return [line.split("\t") for line in r.stdout.splitlines() if line.strip()]


def slugs_for_branch(rows: list[list[str]], branch: str) -> list[str]:
    """Every work-file slug whose recorded branch is `branch`."""
    return [row[0] for row in rows if len(row) >= 3 and row[2] == branch]


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="build-report",
        description="Write /ship's dated build report to docs/studious/build-reports/.",
    )
    parser.add_argument("--repo", default=".", help="path to the repo docs/studious/build-reports/ is written under")
    parser.add_argument("--slug", default=None, help="override the story's slug (default: the work file whose branch is the repo's current branch)")
    parser.add_argument("--content", required=True, help="path to the already-assembled markdown report body")
    parser.add_argument("--date", default=None, help="report date, YYYY-MM-DD (default: today, UTC)")
    parser.add_argument("--force", action="store_true", help="overwrite an existing report at the same date+slug")
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    repo = Path(args.repo).resolve()

    slug = args.slug
    if slug is None:
        branch = branch_to_match(repo)
        matches = slugs_for_branch(work_rows(repo), branch) if branch else []
        if len(matches) > 1:
            print(
                f"error: {len(matches)} work files record branch '{branch}' in {repo} "
                f"({', '.join(sorted(matches))}) -- ambiguous; pass --slug to name the story explicitly",
                file=sys.stderr,
            )
            return 2
        if not matches:
            print(
                f"error: no work file records branch '{branch or '?'}' in {repo} "
                "(gate-ledger work-list); pass --slug to name the story explicitly",
                file=sys.stderr,
            )
            return 2
        slug = matches[0]
    if "/" in slug or ".." in slug or not slug.strip():
        print(f"error: --slug '{slug}' must be a plain identifier (no '/' or '..')", file=sys.stderr)
        return 2
    if args.date is not None and not DATE_RE.match(args.date):
        print(f"error: --date '{args.date}' must be YYYY-MM-DD", file=sys.stderr)
        return 2

    content_path = Path(args.content)
    if not content_path.is_file():
        print(f"error: --content '{content_path}' does not exist", file=sys.stderr)
        return 2

    date = args.date or datetime.now(timezone.utc).strftime("%Y-%m-%d")
    reports_root = repo / "docs" / "studious" / "build-reports"
    report_path = reports_root / f"{date}-{slug}-build-report.md"

    if report_path.exists() and not args.force:
        print(
            f"error: build report already exists: {report_path}\n"
            "Pass --force to overwrite, or remove it first if this is a stale write.",
            file=sys.stderr,
        )
        return 2

    reports_root.mkdir(parents=True, exist_ok=True)
    report_path.write_text(content_path.read_text(encoding="utf-8"), encoding="utf-8")

    print(f"build-report: wrote {report_path}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
